/**app.wxss**/
page {
  background-color: #F7F7F7;  /* 微信标准浅灰 */
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* ===== 全局页面布局样式 ===== */
/* 注释掉自定义的 .page 样式，使用小程序原生布局 */
/* .page {
  width: 100%;
  max-width: 750px;
  margin: 0 auto;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
} */

/* 内容区域 - 如果使用 page-content 包装 */
.page-content {
  box-sizing: border-box;
  width: 100%;
  padding: 0 32rpx;
}

/* 底部操作栏 - 使用小程序原生布局 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E5E5E5;  /* 1rpx 标准分割线 */
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);  /* 轻量阴影 */
  z-index: 100;
  box-sizing: border-box;
}

/* 页面标题区域 */
.page-title {
  padding: 32rpx;
  font-size: 36rpx;  /* 18px - 符合规范 */
  font-weight: 600;
  color: #000000;  /* 微信标准主要文字 */
  line-height: 1.4;
  text-align: center;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 渐变背景（品牌蓝）*/
.gradient-bg {
  background: linear-gradient(180deg, #2563EB 0%, #1D4ED8 100%);
  position: relative;
  overflow: hidden;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;  /* 8px - 适中圆角 */
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);  /* 轻量阴影 */
}

/* ===== 按钮样式 ===== */
/* 主要按钮 - 品牌蓝 */
.btn-primary {
  background: #2563EB;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 20rpx 32rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: background 0.2s;
}

.btn-primary:active {
  background: #1D4ED8;
}

/* 次要按钮 */
.btn-secondary {
  background: #ffffff;
  color: #000000;
  border: 1rpx solid #E5E5E5;
  border-radius: 8rpx;
  padding: 20rpx 32rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: background 0.2s;
}

.btn-secondary:active {
  background: #F7F7F7;
}

/* 警告按钮 - 微信红 */
.btn-danger {
  background: #FA5151;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 20rpx 32rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: background 0.2s;
}

.btn-danger:active {
  background: #D93F3F;
}

/* 保留旧样式（兼容性）*/
.btn-gradient {
  background: linear-gradient(135deg, #6366f1 0%, #9333ea 100%);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  border: none;
}

.btn-gradient-green {
  background: linear-gradient(135deg, #10b981 0%, #0d9488 100%);
  color: #fff;
}

.btn-gradient-blue {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #fff;
}

/* ===== 文本样式 ===== */
/* 主要文字 */
.text-primary {
  color: #000000;
}

/* 次要文字 */
.text-secondary {
  color: #666666;
}

/* 辅助文字 */
.text-tertiary {
  color: #999999;
}

/* 禁用文字 */
.text-disabled {
  color: #CCCCCC;
}

/* 链接文字（微信蓝）*/
.text-link {
  color: #576B95;
}

/* 成功（品牌蓝）*/
.text-success {
  color: #2563EB;
}

/* 警告（微信橙）*/
.text-warning {
  color: #FFC300;
}

/* 错误（微信红）*/
.text-error {
  color: #FA5151;
}

/* 信息（微信蓝）*/
.text-info {
  color: #10AEFF;
}

/* 保留的旧类名（兼容性）*/
.text-gray {
  color: #666666;
}

.text-gray-dark {
  color: #111111;
}

.text-light {
  color: #999999;
}
