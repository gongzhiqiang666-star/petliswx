/* components/report-modal/report-modal.wxss */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-container {
  width: 90%;
  max-width: 600px;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #e5e7eb;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.close-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 8rpx;
}

.modal-content {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.section {
  margin-bottom: 32rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e5e7eb;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-item.full-width {
  grid-column: 1 / -1;
}

.info-label {
  font-size: 24rpx;
  color: #6b7280;
}

.info-value {
  font-size: 28rpx;
  color: #111827;
  font-weight: 500;
}

.status-0 {
  color: #f59e0b;
}

.status-1 {
  color: #10b981;
}

.status-2 {
  color: #ef4444;
}

.modal-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #e5e7eb;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.btn-action {
  flex: 1;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s;
}

.btn-action::after {
  border: none;
}

.btn-preview {
  background: linear-gradient(135deg, #6366f1 0%, #9333ea 100%);
  border-color: transparent;
  color: #fff;
}

.btn-download {
  background: #fff;
  border-color: #6366f1;
  color: #6366f1;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
}

.status-completed {
  color: #10b981;
}
