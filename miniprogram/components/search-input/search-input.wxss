/* 搜索输入组件样式 */
/* 微信原生简洁风格 */

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 0 32rpx;
  border: 1rpx solid #E5E5E5;
  transition: all 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-input-wrapper:focus-within {
  background-color: #FFFFFF;
  border-color: #2563EB;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #000000;
  height: 100%;
}

.search-input::placeholder {
  color: #CCCCCC;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0.4;
  transition: opacity 0.2s;
}

.clear-icon:active {
  opacity: 0.8;
}
