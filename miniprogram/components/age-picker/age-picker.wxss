/* components/age-picker/age-picker.wxss */
.age-picker {
  width: 100%;
}

.picker-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 0;
  background: transparent;
}

.picker-item {
  display: flex;
  flex: 1;
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #E5E5E5;
  border-radius: 16rpx;
  background: #F8F8F8;
}

.picker-item:first-child {
  margin-right: 24rpx;
}

.picker-item picker {
  flex: 1;
  min-width: 0;
}

.picker-label {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: #666666;
  font-size: 26rpx;
  white-space: nowrap;
}

.picker-value {
  display: flex;
  position: relative;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: transparent;
  color: #1A1A1A;
  font-size: 28rpx;
  text-align: center;
}

.picker-clickable {
  cursor: pointer;
}

.picker-clickable::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.05);
  opacity: 0;
  transition: opacity 0.3s;
}

.picker-clickable:active::after {
  opacity: 1;
}

.value-text {
  flex: 1;
  text-align: center;
}

.picker-arrow {
  flex-shrink: 0;
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}
