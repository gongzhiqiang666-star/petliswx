/* components/age-picker/age-picker.wxss */
.age-picker {
  width: 100%;
}

.picker-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 0;
  background: transparent;
}

.picker-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.picker-item:first-child {
  margin-right: 24rpx;
}

.picker-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
  white-space: nowrap;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.picker-clickable {
  cursor: pointer;
}

.picker-clickable::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.05);
  opacity: 0;
  transition: opacity 0.3s;
}

.picker-clickable:active::after {
  opacity: 1;
}

.value-text {
  flex: 1;
  text-align: center;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
  transform: scale(0.8);
}
