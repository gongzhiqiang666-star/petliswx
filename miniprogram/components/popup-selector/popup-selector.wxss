@import "../../styles/petlis-3-overrides.wxss";
/* components/popup-selector/popup-selector.wxss */

.popup-selector {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.popup-selector.show {
  opacity: 1;
  visibility: visible;
}

.popup-selector.petlis-modal-mask {
  display: block;
  padding: 0;
}

.selector-content.petlis-modal {
  width: 100%;
  max-width: none;
  padding: 0;
  border-radius: 28rpx 28rpx 0 0 !important;
}

.selector-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.popup-selector.show .selector-content {
  transform: translateY(0);
}

/* 标题栏 */
.selector-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #e5e7eb;
  flex-shrink: 0;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.close-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

/* 搜索框 */
.search-bar {
  display: flex;
  height: 88rpx;
  align-items: center;
  box-sizing: border-box;
  margin: 24rpx 32rpx;
  padding: 0 24rpx;
  border: 1rpx solid #E3EAE7;
  border-radius: 16rpx;
  background: #F5F7F6;
  flex-shrink: 0;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 86rpx;
  margin-left: 16rpx;
  color: #263832;
  font-size: 28rpx;
  line-height: 86rpx;
}

.search-input::placeholder {
  color: #AAAAAA;
}

.clear-icon {
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  margin-left: 12rpx;
  padding: 18rpx;
  flex-shrink: 0;
  opacity: 0.55;
}

/* 列表 */
.selector-list {
  flex: 1;
  padding: 0 32rpx 32rpx;
  overflow-y: auto;
}

.list-item {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  background: transparent;
  transition: background-color 0.2s;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item.active {
  background: transparent;
}

.item-content {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  color: #111827;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-item.active .item-name {
  color: #0D6E6E;
}

.item-name-en {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-check {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e5e7eb;
  border-top-color: #0D6E6E;
  border-radius: 50%;
  margin-right: 16rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 没有更多 */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #d1d5db;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.selector-loading {
  padding: 48rpx 32rpx;
  color: #85968F;
  font-size: 24rpx;
  text-align: center;
}

.selector-error .empty-text {
  color: #C96F45;
}
