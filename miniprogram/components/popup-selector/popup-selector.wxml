<!--components/popup-selector/popup-selector.wxml-->
<view class="popup-selector {{visible ? 'show' : ''}}" catchtap="onMaskTap">
  <view class="selector-content" catchtap="onContentTap">
    <!-- 标题栏 -->
    <view class="selector-header">
      <text class="header-title">{{title}}</text>
      <image class="close-icon"
             src="/assets/icons/close-icon.png"
             bindtap="onClose"></image>
    </view>

    <!-- 搜索框 -->
    <view class="search-bar" wx:if="{{showSearch}}">
      <image class="search-icon" src="/assets/icons/search-icon.png"></image>
      <input class="search-input"
             placeholder="{{searchPlaceholder}}"
             value="{{searchKeyword}}"
             bindinput="onSearch" />
      <image class="clear-icon"
             src="/assets/icons/close-icon.png"
             wx:if="{{searchKeyword}}"
             bindtap="onClearSearch"></image>
    </view>

    <!-- 列表 -->
    <scroll-view class="selector-list" scroll-y bindscrolltolower="onScrollToLower">
      <view class="list-item {{selectedId === item[itemIdKey] ? 'active' : ''}}"
            wx:for="{{filteredItems}}"
            wx:key="itemIdKey"
            bindtap="onSelect"
            data-item="{{item}}">
        <view class="item-content">
          <view class="item-name">{{item[itemNameKey]}}</view>
          <view class="item-name-en" wx:if="{{item[itemNameEnKey]}}">{{item[itemNameEnKey]}}</view>
        </view>
        <view class="item-check" wx:if="{{selectedId === item[itemIdKey]}}">
          <image src="/assets/icons/check-circle.png" class="check-icon"></image>
        </view>
      </view>

      <!-- 加载更多 -->
      <view class="loading-more" wx:if="{{loading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <!-- 没有更多了 -->
      <view class="no-more" wx:if="{{!hasMore && filteredItems.length > 0 && !loading}}">
        <text class="no-more-text">没有更多了</text>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{filteredItems.length === 0 && !loading}}">
        <image src="/assets/icons/info-icon.png" class="empty-icon"></image>
        <text class="empty-text">{{emptyText}}</text>
      </view>
    </scroll-view>
  </view>
</view>
