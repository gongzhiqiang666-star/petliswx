.remark-card{border:1rpx solid #dce8e4;border-radius:16rpx;padding:20rpx;margin-top:16rpx;background:#fff}.remark-toolbar{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:16rpx}.remark-toolbar button{margin:0;padding:0 18rpx;min-height:72rpx;line-height:72rpx;font-size:24rpx;color:#245e58;background:#f0f6f3;border-radius:12rpx}.remark-toolbar button::after{border:0}.remark-toolbar button[disabled]{color:#8a9c96}.remark-editor{min-height:280rpx;max-height:560rpx;font-size:28rpx;line-height:1.7;color:#183d3b}.remark-hint{font-size:24rpx;line-height:1.6;color:#66817f;margin-top:12rpx}.remark-error{font-size:26rpx;line-height:1.7;color:#9c4935}
