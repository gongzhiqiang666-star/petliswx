/**
 * PETLIS 全局样式
 * 品牌青绿配色方案
 */

/* ==================== 颜色变量 ==================== */
page
{
  /* 主色 */
  --primary-color: #0D6E6E;
  --primary-hover: #0A5A5A;
  --primary-light: #D5EAE4;
  --primary-lighter: #EAF4F1;

  /* 辅助色 */
  --secondary-color: #64748B;
  --secondary-hover: #475569;

  /* 功能色 */
  --success-color: #10B981;
  --warning-color: #F59E0B;
  --error-color: #EF4444;
  --info-color: #0D6E6E;

  /* 背景色 */
  --bg-primary: #FFFFFF;
  --bg-secondary: #F8FAFC;
  --bg-tertiary: #F1F5F9;

  /* 文字色 */
  --text-primary: #1E293B;
  --text-secondary: #475569;
  --text-tertiary: #94A3B8;
  --text-placeholder: #CBD5E1;

  /* 边框色 */
  --border-color: #E2E8F0;
  --border-color-light: #F1F5F9;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 12rpx;
  --spacing-md: 16rpx;
  --spacing-lg: 24rpx;
  --spacing-xl: 32rpx;
}

/* ==================== 卡片样式 ==================== */
.card
{
  background: #fff;
  border-radius: 24rpx;
  padding: 64rpx 56rpx;
  margin: 0 32rpx 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-header
{
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 56rpx;
}

.header-line
{
  width: 8rpx;
  height: 40rpx;
  background: #0D6E6E;
  border-radius: 4rpx;
}

.card-title
{
  font-size: 36rpx;
  color: #111827;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

/* ==================== 表单样式 ==================== */
.form-section
{
  padding: 44rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.form-section:last-child
{
  border-bottom: none;
}

.form-item
{
  margin-bottom: 40rpx;
}

.form-item:last-child
{
  margin-bottom: 0;
}

.form-row
{
  display: flex;
  gap: 32rpx;
}

.form-item.half
{
  flex: 1;
  min-width: 0;
}

.form-group
{
  margin-bottom: 48rpx;
}

.form-label
{
  font-size: 32rpx;
  color: #374151;
  margin-bottom: 24rpx;
  display: block;
  font-weight: 500;
  letter-spacing: 0.3rpx;
}

.required
{
  color: #ef4444;
  margin-left: 6rpx;
}

.form-input
{
  width: 100%;
  height: 120rpx;
  padding: 0 44rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #111827;
  box-sizing: border-box;
  transition: all 0.3s;
}

.form-input:focus
{
  border-color: #0D6E6E;
  box-shadow: 0 0 0 6rpx rgba(13, 110, 110, 0.1);
}

.form-input::placeholder
{
  color: #9ca3af;
}

.form-textarea
{
  width: 100%;
  min-height: 180rpx;
  padding: 28rpx 44rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #111827;
  box-sizing: border-box;
  line-height: 1.6;
}

.form-textarea::placeholder
{
  color: #9ca3af;
}

.form-picker
{
  width: 100%;
  height: 120rpx;
  padding: 0 44rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  transition: all 0.3s;
}

.form-picker:active
{
  border-color: #0D6E6E;
}

.picker-value
{
  flex: 1;
  font-size: 32rpx;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow
{
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.form-tip
{
  font-size: 28rpx;
  color: #9ca3af;
  margin-top: 20rpx;
  padding-left: 12rpx;
  line-height: 1.6;
}

.age-display
{
  margin-top: 24rpx;
  padding: 28rpx 36rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #374151;
  border: 1rpx solid #e5e7eb;
}

/* ==================== 按钮样式 ==================== */
.gender-group
{
  display: flex;
  gap: 28rpx;
}

.gender-btn
{
  flex: 1;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #374151;
  transition: all 0.3s;
  font-weight: 500;
}

.gender-btn.active
{
  border-color: #0D6E6E;
  background: #eef2ff;
  color: #0D6E6E;
  transform: scale(1.02);
}

.btn-primary
{
  flex: 1;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0D6E6E 0%, #0A5A5A 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(13, 110, 110, 0.25);
  transition: all 0.3s;
}

.btn-primary:active
{
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-primary::after
{
  border: none;
}

.btn-secondary
{
  flex: 1;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #374151;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.btn-secondary:active
{
  background: #f9fafb;
}

.btn-secondary::after
{
  border: none;
}

.btn-full
{
  width: 100%;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0D6E6E 0%, #0A5A5A 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(13, 110, 110, 0.25);
  transition: all 0.3s;
}

.btn-full:active
{
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-full::after
{
  border: none;
}

/* ==================== 底部操作栏 ==================== */
.bottom-actions
{
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-row
{
  display: flex;
  gap: 24rpx;
}
