/* pages/pet-health/pet-health.wxss */

/* Header */
.header {
  background: #fff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #e5e7eb;
}

.back-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.header-title {
  font-size: 36rpx;
  color: #111827;
  font-weight: 600;
}

.pet-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #f9fafb;
  border-radius: 24rpx;
}

.selected-pet {
  font-size: 28rpx;
  color: #111827;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
}

/* Tabs */
.tabs {
  background: #fff;
  display: flex;
  border-bottom: 2rpx solid #e5e7eb;
  padding: 0 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}

.tab-item.active {
  color: #6366f1;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #6366f1;
}

/* Content */
.content {
  height: calc(100vh - 200rpx);
}

.tab-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Vaccine Card */
.vaccine-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
}

.vaccine-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.vaccine-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.vaccine-name {
  font-size: 32rpx;
  color: #111827;
  font-weight: 500;
}

.vaccine-date {
  font-size: 28rpx;
  color: #6b7280;
}

.vaccine-tag {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.vaccine-tag.required {
  background: #fef2f2;
  color: #dc2626;
}

.vaccine-tag.recommended {
  background: #eff6ff;
  color: #2563eb;
}

.vaccine-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  font-size: 28rpx;
}

.vaccine-detail-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #4b5563;
}

.vaccine-detail-item.valid {
  color: #059669;
}

.detail-icon {
  width: 28rpx;
  height: 28rpx;
}

/* Timeline */
.timeline {
  position: relative;
}

.timeline-item {
  position: relative;
  padding-left: 64rpx;
  padding-bottom: 48rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 32rpx;
  height: 32rpx;
  background: #6366f1;
  border-radius: 50%;
  border: 8rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 1;
}

.timeline-line {
  position: absolute;
  left: 16rpx;
  top: 48rpx;
  bottom: -32rpx;
  width: 2rpx;
  background: #e5e7eb;
}

.timeline-content {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
}

.checkup-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.checkup-date {
  font-size: 28rpx;
  color: #111827;
}

.checkup-doctor {
  font-size: 28rpx;
  color: #6b7280;
}

.checkup-details {
  margin-bottom: 24rpx;
}

.checkup-detail-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.detail-label {
  color: #6b7280;
}

.detail-value {
  color: #111827;
}

.weight-change {
  font-size: 24rpx;
  color: #059669;
}

.checkup-summary {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

.checkup-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #6366f1;
  padding-top: 24rpx;
  border-top: 2rpx solid #f3f4f6;
}

/* Medical Card */
.medical-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
}

.medical-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.medical-type {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.medical-type.visit {
  background: #fef3c7;
  color: #d97706;
}

.medical-type.medicine {
  background: #dbeafe;
  color: #2563eb;
}

.medical-date {
  font-size: 24rpx;
  color: #6b7280;
}

.medical-diagnosis {
  font-size: 32rpx;
  color: #111827;
  font-weight: 500;
  margin-bottom: 24rpx;
  display: block;
}

.medical-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  font-size: 28rpx;
}

.medical-detail-item {
  display: flex;
  gap: 8rpx;
}

/* Add Button */
.add-btn {
  background: #fff;
  border: 4rpx dashed #d1d5db;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #6366f1;
  font-size: 28rpx;
}

.add-icon {
  width: 40rpx;
  height: 40rpx;
}

/* FAB */
.fab {
  position: fixed;
  bottom: 200rpx;
  right: 48rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #6366f1 0%, #9333ea 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.4);
  z-index: 50;
}

.fab-icon {
  width: 48rpx;
  height: 48rpx;
}
