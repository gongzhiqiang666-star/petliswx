<view class="page">
  <view class="pet-selector petlis-input"><text class="selected-pet">{{selectedPet || '宠物健康档案'}}</text></view>
  <view class="tabs petlis-filters">
    <view class="tab-item petlis-filter-item {{activeTab === 'medical' ? 'active' : ''}}" bindtap="onTabChange" data-tab="medical">病史记录</view>
    <view class="tab-item petlis-filter-item {{activeTab === 'reports' ? 'active' : ''}}" bindtap="onTabChange" data-tab="reports">送检报告</view>
  </view>
  <view class="petlis-empty health-state health-state-error" wx:if="{{loadError}}" role="alert">
    <image src="/assets/icons/brand-empty.png" mode="aspectFit" aria-hidden="true" />
    <view class="petlis-empty-text">{{loadError}}</view>
    <button class="petlis-btn petlis-btn-outline petlis-empty-retry" bindtap="retryLoad">重新加载</button>
  </view>
  <scroll-view class="content" scroll-y bindscrolltolower="onReachBottom" wx:else>
    <view class="tab-content" wx:if="{{activeTab === 'medical'}}">
      <view class="medical-card petlis-list-card" wx:for="{{medicalRecords}}" wx:key="id">
        <view class="medical-header"><view class="medical-type visit">送检病史</view><text class="medical-date">{{item.date}}</text></view>
        <text class="medical-diagnosis">{{item.diagnosis}}</text>
        <view class="medical-details"><view class="medical-detail-item"><text class="detail-label">临床记录：</text><text class="detail-value">{{item.treatment}}</text></view></view>
      </view>
      <view class="petlis-empty health-state" wx:if="{{!loading && !medicalRecords.length}}"><image src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">暂无病史记录</view></view>
    </view>
    <view class="tab-content" wx:if="{{activeTab === 'reports'}}">
      <view class="medical-card petlis-list-card" wx:for="{{reports}}" wx:key="reportId" bindtap="onViewReport" data-id="{{item.reportId}}">
        <view class="medical-header"><text class="medical-diagnosis">{{item.testTypeName}}</text><text class="medical-date">{{item.createDt}}</text></view>
        <view class="medical-detail-item"><text class="detail-label">送检单：</text><text class="detail-value">{{item.orderNo || item.orderId}}</text></view>
      </view>
      <view class="petlis-empty health-state" wx:if="{{!loading && !reports.length}}"><image src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">暂无既往送检报告</view></view>
    </view>
  </scroll-view>
</view>
