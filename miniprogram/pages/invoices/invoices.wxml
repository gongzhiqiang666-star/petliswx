<view class="page"><view class="filters petlis-filters"><button data-id="apply" class="petlis-filter-item {{tab==='apply'?'active':''}}" disabled="{{busy}}" bindtap="tab">申请开票</button><button data-id="history" class="petlis-filter-item {{tab==='history'?'active':''}}" disabled="{{busy}}" bindtap="tab">开票记录</button></view><view wx:if="{{error}}" class="error petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">{{error}}</view><button class="petlis-btn petlis-btn-outline" bindtap="retry">重试</button></view><view wx:if="{{tab==='apply'}}"><view class="card petlis-list-card"><view class="form-item"><view class="form-label">开票抬头</view><picker range="{{profiles}}" range-key="title" value="{{profileIndex}}" bindchange="profile"><view class="nav petlis-input"><text class="nav-label">{{profiles[profileIndex].title || '请添加开票信息'}}</text><image class="nav-chevron" src="/assets/icons/brand-chevron-down.png" mode="aspectFit" /></view></picker></view><view class="card-actions"><button wx:if="{{profiles.length}}" class="petlis-btn petlis-btn-outline" bindtap="editProfile" disabled="{{busy}}"><image class="button-icon" src="/assets/icons/brand-edit.png" mode="aspectFit" />编辑当前抬头</button><button class="petlis-btn petlis-btn-outline" bindtap="adding" disabled="{{busy}}"><image class="button-icon" src="/assets/icons/brand-plus.png" mode="aspectFit" />{{adding?'收起':'添加开票信息'}}</button></view><view wx:if="{{adding}}" class="petlis-modal-mask"><view class="petlis-modal"><view class="petlis-modal-title">开票信息</view><view class="petlis-modal-content"><view class="form-item"><view class="form-label">发票抬头</view><input class="petlis-input" data-field="title" value="{{title}}" bindinput="field" placeholder="请输入发票抬头" maxlength="200"/></view><view class="form-item"><view class="form-label">税号（企业必填）</view><input class="petlis-input" data-field="taxNumber" value="{{taxNumber}}" bindinput="field" placeholder="请输入税号" maxlength="20"/></view><view class="form-item"><view class="form-label">接收邮箱</view><input class="petlis-input" data-field="email" value="{{email}}" bindinput="field" placeholder="请输入接收邮箱" maxlength="200"/></view><view class="form-item"><view class="form-label">注册地址（选填）</view><input class="petlis-input" data-field="address" value="{{address}}" bindinput="field" placeholder="请输入注册地址" maxlength="300"/></view><view class="form-item"><view class="form-label">联系电话（选填）</view><input class="petlis-input" data-field="phone" value="{{phone}}" bindinput="field" placeholder="请输入联系电话" maxlength="30"/></view><view class="form-item"><view class="form-label">开户银行（选填）</view><input class="petlis-input" data-field="bankName" value="{{bankName}}" bindinput="field" placeholder="请输入开户银行" maxlength="200"/></view><view class="form-item"><view class="form-label">银行账号（选填）</view><input class="petlis-input" data-field="bankAccount" value="{{bankAccount}}" bindinput="field" placeholder="请输入银行账号" maxlength="100"/></view></view><view class="petlis-modal-actions"><button class="petlis-btn petlis-btn-outline" bindtap="adding" disabled="{{busy}}">取消</button><button class="petlis-btn petlis-btn-primary" bindtap="saveProfile" disabled="{{busy}}">保存开票信息</button></view></view></view></view><view class="section-title">可开票订单</view><view wx:for="{{orders}}" wx:key="orderId" class="card petlis-list-card" data-id="{{item.orderId}}" bindtap="toggle"><checkbox checked="{{item.checked}}" color="#0D6E6E"/>{{item.orderNo}} · {{item.animalName}}<view class="meta">可开票金额 ¥{{item.amount}}</view></view><view wx:if="{{!busy && !orders.length}}" class="empty petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view>暂无可开票订单</view></view><view class="hint list-hint">仅展示你本人已支付、未申请开票的订单，最多一次选择50单。</view><button wx:if="{{more}}" class="petlis-btn petlis-btn-outline" bindtap="more" loading="{{busy}}">加载更多</button><view class="bottom-actions"><button class="petlis-btn petlis-btn-primary" bindtap="apply" disabled="{{busy || !selected.length}}" loading="{{busy}}">提交开票（{{selected.length}}单）</button></view></view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card petlis-list-card"><view>申请 #{{item.id}} · ¥{{item.amount}}</view><view class="badge">{{item.status==='pending'?'待处理':item.status==='issued'?'已开具':'已驳回'}}</view><view wx:if="{{item.rejectReason}}" class="hint">驳回原因：{{item.rejectReason}}</view><view class="card-actions"><button wx:if="{{item.status==='issued'}}" class="petlis-btn petlis-btn-outline" data-url="{{item.invoiceUrl}}" bindtap="download" disabled="{{busy}}"><image class="button-icon" src="/assets/icons/brand-download.png" mode="aspectFit" />下载电子发票</button></view></view><view wx:if="{{!busy && !items.length}}" class="empty petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view>暂无开票记录</view></view><button wx:if="{{more}}" class="petlis-btn petlis-btn-outline" bindtap="more" loading="{{busy}}">加载更多</button></view></view>