/* pages/notifications/notifications.wxss */
/* 消息提醒页面 - 微信原生简洁风格 */

/* ============================================
   页面容器
   ============================================ */
.notifications-page {
  min-height: 100vh;
  background: #F7F7F7;
  display: flex;
  flex-direction: column;
}

/* ============================================
   加载状态
   ============================================ */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  gap: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E5E5E5;
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E5E5E5;
  border-top-color: #2563EB;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666666;
}

/* ============================================
   通知列表
   ============================================ */
.notification-list {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ============================================
   列表分段标题（替代页面头部）
   ============================================ */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 8rpx 24rpx 8rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.4;
}

.header-stats {
  background: #2563EB;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.stats-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1;
}

/* ============================================
   通知项
   ============================================ */
.notification-item {
  position: relative;
  background: #ffffff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
  border: 1rpx solid #F0F0F0;
}

.notification-item:active {
  background: #F7F7F7;
  border-color: #2563EB;
}

/* 左侧状态条 */
.status-line {
  width: 6rpx;
  background: #2563EB;
  flex-shrink: 0;
}

/* 已读项样式 */
.item-read {
  opacity: 0.7;
}

.item-read .status-line {
  background: #E5E5E5;
}

/* 内容区域 */
.item-content {
  flex: 1;
  padding: 24rpx 24rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 96rpx;
}

/* 头部 */
.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 状态标签 */
.status-tag {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.status-pending {
  background: #FFF7ED;
}

.status-completed {
  background: #F0FDF4;
}

.status-rejected {
  background: #FEF2F2;
}

.status-processing {
  background: #EFF6FF;
}

.tag-icon {
  font-size: 28rpx;
  line-height: 1;
}

.item-time {
  font-size: 24rpx;
  color: #666666;
}

/* 消息内容 */
.item-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.4;
}

.item-message {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
}

.message-text {
  font-size: 26rpx;
  color: #666666;
}

.status-highlight {
  font-size: 26rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  background: #F0F9FF;
  border-radius: 4rpx;
  color: #2563EB;
}

.item-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

/* 底部信息 */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 4rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-item {
  font-size: 24rpx;
  color: #888888;
}

.info-divider {
  font-size: 24rpx;
  color: #CCCCCC;
}

.arrow-icon {
  font-size: 32rpx;
  color: #CCCCCC;
  font-weight: 300;
}

/* ============================================
   加载更多
   ============================================ */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  gap: 12rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: #888888;
}

/* ============================================
   没有更多
   ============================================ */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* ============================================
   空状态
   ============================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 32rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #888888;
  text-align: center;
}

/* ============================================
   底部间距
   ============================================ */
.bottom-space {
  height: 40rpx;
}
