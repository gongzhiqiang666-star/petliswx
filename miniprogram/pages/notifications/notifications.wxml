<view class="page"><view class="row"><view class="notification-filter petlis-filters"><button class="petlis-filter-item {{unread?'active':''}}" bindtap="filter" disabled="{{busy}}">{{unread?'只看未读':'全部消息'}} · 未读{{count}}</button></view><button class="petlis-btn petlis-btn-outline" bindtap="all" disabled="{{busy || count===0}}"><image class="button-icon" src="/assets/icons/brand-check.png" mode="aspectFit" />全部已读</button></view><view wx:if="{{error}}" class="error petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">{{error}}</view><button class="petlis-btn petlis-btn-outline" bindtap="retry">重试</button></view><view wx:for="{{items}}" wx:key="id" class="card petlis-list-card" data-id="{{item.id}}" data-page="{{item.pagePath}}" bindtap="read"><view class="notification-title"><view wx:if="{{!item.readAt}}" class="unread-dot"></view><text>{{item.title}}</text></view><view class="hint">{{item.message}}</view><view class="meta">{{item.createdAt}}</view><text class="badge">查看详情<image class="badge-icon" src="/assets/icons/brand-chevron-right.png" mode="aspectFit" /></text><view class="meta">微信推送：{{item.pushLabel}}</view><view class="row card-actions"><button class="petlis-btn petlis-btn-outline" data-id="{{item.id}}" catchtap="deliveryLogs" disabled="{{deliveryBusy}}">{{deliveryId===item.id?'收起发送记录':'发送记录'}}</button><button wx:if="{{item.canRetry}}" class="petlis-btn petlis-btn-primary" data-id="{{item.id}}" catchtap="retryDelivery" disabled="{{retryingId}}" loading="{{retryingId===item.id}}">重试推送</button></view><view wx:if="{{deliveryId===item.id}}" class="delivery"><view wx:if="{{deliveryBusy}}" class="meta">正在加载…</view><view wx:elif="{{!deliveries.length}}" class="meta">暂无发送记录</view><view wx:for="{{deliveries}}" wx:for-item="delivery" wx:key="index" class="meta">{{delivery.createdAt}} · {{delivery.statusLabel}}<view wx:if="{{delivery.errorMessage}}">{{delivery.errorMessage}}</view></view></view></view><view wx:if="{{!busy && !items.length && !error}}" class="empty petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view>{{unread?'没有未读消息':'暂无消息'}}</view></view><button wx:if="{{more}}" class="petlis-btn petlis-btn-outline" bindtap="more" loading="{{busy}}">加载更多</button></view>
