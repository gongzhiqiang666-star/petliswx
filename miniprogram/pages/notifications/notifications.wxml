<!--pages/notifications/notifications.wxml-->
<!-- 消息提醒页面 - 微信原生简洁风格 -->
<view class="notifications-page" role="main" aria-label="消息通知列表">
  <!-- 加载状态 -->
  <view class="loading-container"
        role="status"
        aria-live="polite"
        aria-label="正在加载消息通知"
        wx:if="{{loading}}">
    <view class="loading-spinner" aria-hidden="true"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 通知列表 -->
  <scroll-view
    class="notification-list"
    scroll-y
    wx:if="{{!loading}}"
    bindscrolltolower="onReachBottom"
    enhanced
    show-scrollbar="{{false}}"
    role="list"
    aria-label="消息通知列表"
  >
    <!-- 列表顶部分段标题 -->
    <view class="list-header" wx:if="{{notifications.length > 0}}">
      <text class="header-title">消息通知</text>
      <view class="header-stats" role="status" aria-label="{{unreadCount}}条未读消息" wx:if="{{unreadCount > 0}}">
        <text class="stats-text">{{unreadCount}}条未读</text>
      </view>
    </view>

    <!-- 通知项 -->
    <view
      class="notification-item {{item.wechatSentStatus === 1 ? 'item-read' : 'item-unread'}}"
      wx:for="{{notifications}}"
      wx:key="id"
      bindtap="onNotificationTap"
      data-notification="{{item}}"
      role="listitem"
      tabindex="0"
      aria-label="{{item.notificationMessage || '订单状态更新' + (item.newStatusLabel ? '，' + item.newStatusLabel : '')}}，{{item.time}}，{{item.wechatSentStatus === 1 ? '已读' : '未读'}}"
    >
      <!-- 左侧状态条 -->
      <view class="status-line" wx:if="{{item.wechatSentStatus !== 1}}"></view>

      <!-- 内容区域 -->
      <view class="item-content">
        <!-- 头部 -->
        <view class="item-header">
          <view class="status-tag status-{{item.statusClass}}">
            <text class="tag-icon">{{item.statusIcon}}</text>
          </view>
          <text class="item-time">{{item.time}}</text>
        </view>

        <!-- 消息内容 -->
        <view class="item-body">
          <text class="item-title">订单状态更新</text>
          <view class="item-message" wx:if="{{!item.notificationMessage}}">
            <text class="message-text">状态变更为</text>
            <text class="status-highlight" style="color: {{item.statusColor}}">{{item.newStatusLabel}}</text>
          </view>
          <text class="item-desc" wx:else>{{item.notificationMessage}}</text>
        </view>

        <!-- 底部信息 -->
        <view class="item-footer" wx:if="{{item.animalName || item.masterName}}">
          <view class="info-row">
            <text class="info-item" wx:if="{{item.animalName}}">{{item.animalName}}</text>
            <text class="info-divider" wx:if="{{item.animalName && item.masterName}}">·</text>
            <text class="info-item" wx:if="{{item.masterName}}">{{item.masterName}}</text>
          </view>
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more"
          role="status"
          aria-live="polite"
          aria-label="正在加载更多消息"
          wx:if="{{isLoadingMore}}">
      <view class="loading-spinner small" aria-hidden="true"></view>
      <text class="load-more-text">加载更多...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more"
          role="status"
          aria-label="已加载全部消息"
          wx:if="{{!hasMore && notifications.length > 0}}">
      <text class="no-more-text">— 没有更多了 —</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state"
          role="status"
          aria-label="暂无消息通知"
          wx:if="{{isEmpty && !loading}}">
      <view class="empty-icon" aria-hidden="true">🔔</view>
      <text class="empty-title">暂无新消息</text>
      <text class="empty-desc">订单状态更新时会在这里提醒您</text>
    </view>

    <!-- 底部间距 -->
    <view class="bottom-space"></view>
  </scroll-view>
</view>
