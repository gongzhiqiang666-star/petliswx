<!--pages/order-detail/order-detail.wxml-->
<view class="page" role="main" aria-label="订单详情">
  <!-- Loading State -->
  <view class="loading-state"
        role="status"
        aria-live="polite"
        aria-label="正在加载订单信息"
        wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- Error State -->
  <view class="error-state"
        role="alert"
        aria-label="加载失败"
        wx:if="{{error}}">
    <view class="error-icon">
      <image src="/assets/icons/brand-empty.png" class="icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true"></image>
    </view>
    <view class="error-text">加载失败</view>
    <button class="btn-retry petlis-btn petlis-btn-outline"
            role="button"
            aria-label="重新加载"
            bindtap="loadOrderDetail"
            data-id="{{orderData.orderId}}">重试</button>
  </view>

  <!-- Content -->
  <view wx:if="{{!loading && !error}}">
    <!-- Header Card -->
    <view class="header-card petlis-card"
          role="region"
          aria-label="订单摘要">
      <view class="header-top">
        <view class="order-info">
          <text class="order-no">{{orderData.userNO}}</text>
          <view class="status-badge status-{{orderData.sampleStatus}}">{{orderData.sampleStatusDesc}}</view>
        </view>
        <text class="total-fee">总费用: ¥{{orderData.testFee}}</text>
      </view>
    </view>

    <view wx:if="{{orderData.refunded}}" class="logistics-receipt-note" role="status">已退款{{orderData.refundMock ? '（开发模拟）' : ''}} ¥{{orderData.refundAmount}} · {{orderData.refundedAt}}<view>原因：{{orderData.refundReason}}</view><view>原送检进度保留，后续安排请联系实验室。</view></view>
  <scroll-view class="content {{orderData.canResubmit ? 'has-bottom-action' : ''}}" scroll-y role="main" aria-label="详细信息">
      <view wx:if="{{orderData.reviewReason}}" class="review-notice" role="region" aria-label="最新审核意见">
        <text class="review-notice-title">最新审核意见</text>
        <text class="review-message">{{orderData.reviewReason}}</text>
      </view>
      <view wx:if="{{orderData.reviewHistory.length}}" class="review-card petlis-card" role="region" aria-label="审核记录">
        <view class="card-title"><view class="title-line"></view><text>审核记录</text></view>
        <view role="list">
          <view class="review-entry" wx:for="{{orderData.reviewHistory}}" wx:key="id" role="listitem">
            <text class="review-time">{{item.createdAtLabel}}</text>
            <text class="review-message">{{item.message}}</text>
          </view>
        </view>
      </view>
      <!-- Pet Brief Info -->
      <view class="pet-brief petlis-card"
            role="region"
            aria-label="宠物信息">
        <view class="pet-avatar">
          <image src="/assets/icons/brand-archive.png" class="avatar-icon" mode="aspectFill" lazy-load="{{true}}" aria-hidden="true"></image>
        </view>
        <view class="pet-info">
          <text class="pet-name">{{orderData.animalName}}</text>
          <text class="pet-detail">{{orderData.animalType}} · {{orderData.genderText}} · {{orderData.age}}</text>
        </view>
      </view>

      <!-- Timeline -->
      <view class="timeline-card petlis-card"
            role="region"
            aria-label="订单进度">
        <view class="card-title">
          <view class="title-line"></view>
          <text>订单进度</text>
        </view>
        <view class="timeline"
              role="list"
              aria-label="进度步骤">
          <view class="timeline-item"
                role="listitem"
                wx:for="{{timeline}}"
                wx:key="time">
            <view class="timeline-dot {{item.completed ? 'completed' : ''}} {{item.current ? 'current' : ''}} {{item.pending ? 'pending' : ''}}"
                  aria-label="{{item.completed ? '已完成' : item.pending ? '待处理' : '进行中'}}">
              <image class="timeline-check" src="/assets/icons/brand-check.png" mode="aspectFit" wx:if="{{item.completed}}" aria-hidden="true"></image>
            </view>
            <view class="timeline-content">
              <view class="timeline-header">
                <text class="timeline-title {{item.pending ? 'pending-title' : ''}}">{{item.title}}</text>
                <text class="timeline-time" wx:if="{{item.time}}">{{item.time}}</text>
              </view>
              <view class="timeline-desc" wx:if="{{item.operator}}">
                <text class="operator-label">操作人：</text>
                <text class="operator-name">{{item.operator}}</text>
              </view>
              <view class="timeline-status" wx:if="{{item.status}}">{{item.status}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="timeline-card petlis-card" role="region" aria-label="物流配送">
        <view class="card-title"><view class="title-line"></view><text>物流配送</text></view>
        <view wx:if="{{shipment}}">
          <view wx:if="{{shipment.sandbox}}" class="logistics-receipt-note">沙箱测试运单 · 不会预约真实取件</view>
          <button wx:if="{{shipment.sandbox && shipment.status!=='CANCELLED'}}" class="tracking-copy" style="margin:16rpx 0" loading="{{labelOpening}}" disabled="{{labelOpening}}" bindtap="openShipmentLabel">查看测试面单 PDF</button>
          <view class="logistics-summary"><text>第 {{shipment.attemptNo || 1}} 次寄件 · {{shipment.statusLabel}}</text><button wx:if="{{shipment.trackingNo}}" class="tracking-copy" bindtap="copyTrackingNo" aria-label="复制物流运单号">运单 {{shipment.trackingNo}} · 复制</button></view>
          <button wx:if="{{shipment.attemptNo>1}}" class="tracking-copy" data-action="shipment-history" loading="{{historyOpening}}" disabled="{{historyOpening}}" bindtap="openShipmentHistory">{{historyVisible?'收起寄件历史':'查看历次寄件'}}</button>
          <view wx:if="{{historyError}}" class="logistics-receipt-note">{{historyError}}</view>
          <view wx:if="{{historyVisible}}" class="shipment-history">
            <view wx:for="{{shipmentHistory}}" wx:key="id" class="shipment-history-item">
              <view class="shipment-history-title">第 {{item.attemptNo || 1}} 次 · {{item.current?'当前运单':'历史运单'}} · {{item.statusLabel}}</view>
              <button class="tracking-copy" wx:if="{{item.trackingNo}}" data-index="{{index}}" bindtap="copyHistoryTracking">{{item.trackingNo}} · 复制</button>
              <view class="logistics-receipt-note" wx:for="{{item.timeline}}" wx:for-item="node" wx:key="createdAt">{{node.time}} · {{node.title}}</view>
            </view>
          </view>
          <view wx:if="{{shipment.status==='DELIVERED'}}" class="logistics-receipt-note">快递已妥投，仍需实验室核对样本。此状态不代表核样通过。</view>
          <view wx:elif="{{shipment.status==='RECEIVED'}}" class="logistics-receipt-note">实验室已签收，检测与报告进度请查看对应记录。</view>
          <view class="logistics-eta" wx:if="{{shipment.expectedArrivedAt}}">预计到达：{{shipment.expectedArrivedAt}}</view>
          <view class="logistics-exception" wx:if="{{shipment.exceptionNote}}">异常：{{shipment.exceptionTypeLabel}} · {{shipment.exceptionNote}}</view>
          <view wx:if="{{shipment.exceptions.length}}" class="logistics-receipt-note">异常处理记录</view>
          <view wx:for="{{shipment.exceptions}}" wx:key="id" class="logistics-receipt-note">
            <view>{{item.typeLabel}} · {{item.stateLabel}} · {{item.reportedTime}}</view><view>{{item.note}}</view>
            <view wx:if="{{item.resolvedAt}}">处理说明：{{item.resolutionNote}} · {{item.resolvedTime}}</view>
          </view>
          <view class="timeline-item" wx:for="{{shipmentTimeline}}" wx:key="createdAt">
            <view class="timeline-dot {{item.abnormal ? 'pending' : 'completed'}}"></view>
            <view class="timeline-content"><view class="timeline-header"><text class="timeline-title">{{item.title}}</text><text class="timeline-time">{{item.time}}</text></view></view>
          </view>
        </view>
        <view class="timeline-status" wx:elif="{{logisticsError}}">{{logisticsError}}</view>
        <view class="timeline-status" wx:else>暂无物流记录</view>
      </view>

      <!-- Test Items -->
      <view class="card petlis-card"
            role="region"
            aria-label="检测项目"
            wx:if="{{orderData.items.length > 0}}">
        <view class="card-title">
          <view class="title-line"></view>
          <text>检测项目 ({{orderData.totalItems}}项)</text>
        </view>
        <view class="test-items"
              role="list">
          <view class="test-item petlis-list-card"
                role="listitem"
                aria-label="{{item.name}}，价格¥{{item.price}}，状态{{item.diagnosisStatusLabel}}"
                wx:for="{{orderData.items}}"
                wx:key="itemId"
                wx:for-item="item">
            <view class="test-header">
              <view class="test-name-wrap">
                <image class="test-item-icon" src="/assets/icons/brand-check.png" mode="aspectFit" aria-hidden="true"></image>
                <text class="test-name">{{item.name}}</text>
              </view>
              <text class="test-price">¥{{item.price}}</text>
            </view>
            <view class="test-status">
              <view class="status-dot"></view>
              <text class="status-text">{{item.diagnosisStatusLabel}}</text>
            </view>
            <text class="test-desc" wx:if="{{item.detailRemark}}">备注: {{item.detailRemark}}</text>

            <!-- PDF预览和下载按钮 - 仅在已完成且PDF已生成时显示 -->
            <view class="test-actions" wx:if="{{orderData.sampleStatus === 3 && item.securePdfUrl}}">
              <button class="btn-preview petlis-btn petlis-btn-primary"
                      role="button"
                      aria-label="预览{{item.name}}的检测报告"
                      bindtap="onPreviewPDF"
                      data-url="{{item.securePdfUrl}}">
                <image src="/assets/icons/brand-file.png" class="btn-icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true"></image>
                <text>预览报告</text>
              </button>
              <button class="btn-download petlis-btn petlis-btn-primary"
                      role="button"
                      aria-label="下载{{item.name}}的检测报告"
                      bindtap="onDownloadPDF"
                      data-url="{{item.securePdfUrl}}"
                      data-name="{{item.name}}">
                <image src="/assets/icons/brand-download.png" class="btn-icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true"></image>
                <text>下载报告</text>
              </button>
            </view>
          </view>
        </view>
      </view>

      <!-- Detailed Information -->
      <view class="card petlis-card"
            role="region"
            aria-label="详细信息">
        <view class="card-title">
          <view class="title-line"></view>
          <text>详细信息</text>
        </view>
        <view class="detail-sections">
          <!-- Pet Details -->
          <view class="detail-section">
            <view class="section-title">宠物信息</view>
            <view class="detail-row">
              <text class="detail-label">品种</text>
              <text class="detail-value">{{orderData.animalType}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">性别</text>
              <text class="detail-value">{{orderData.genderText}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">年龄</text>
              <text class="detail-value">{{orderData.age}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">体重</text>
              <text class="detail-value">{{orderData.animalWeight}}kg</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">芯片号</text>
              <text class="detail-value">{{orderData.chipNO || '未填写'}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">生日</text>
              <text class="detail-value">{{orderData.birthday}}</text>
            </view>
          </view>

          <view class="detail-divider"></view>

          <!-- Owner Details -->
          <view class="detail-section">
            <view class="section-title">畜主信息</view>
            <view class="detail-row">
              <text class="detail-label">畜主姓名</text>
              <text class="detail-value">{{orderData.masterName}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">送检医师</text>
              <text class="detail-value">{{orderData.doctorName || '未填写'}}</text>
            </view>
          </view>

          <view class="detail-divider"></view>

          <!-- Sampling Details -->
          <view class="detail-section">
            <view class="section-title">采样信息</view>
            <view class="detail-row">
              <text class="detail-label">采样日期</text>
              <text class="detail-value">{{orderData.collectDt}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">采样部位</text>
              <text class="detail-value">{{orderData.sampleArea || '未填写'}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">收到样本日期</text>
              <text class="detail-value">{{orderData.receiveSampleDt}}</text>
            </view>
          </view>

          <view class="detail-divider"></view>

          <!-- Order Details -->
          <view class="detail-section">
            <view class="section-title">订单信息</view>
            <view class="detail-row">
              <text class="detail-label">订单号</text>
              <text class="detail-value">{{orderData.userNO}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">创建时间</text>
              <text class="detail-value">{{orderData.createDt}}</text>
            </view>
            <view class="detail-row" wx:if="{{orderData.marketingName}}">
              <text class="detail-label">市场活动</text>
              <text class="detail-value">{{orderData.marketingName}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="card petlis-card" role="region" aria-label="本次送检临床资料">
        <view class="card-title"><view class="title-line"></view><text>本次送检临床资料</text></view>
        <view class="remark-content" wx:if="{{clinicalLoading}}">正在加载临床资料…</view>
        <view class="remark-content" wx:elif="{{clinicalError}}"><text>临床资料暂不可用</text><button class="petlis-btn petlis-btn-outline" bindtap="loadClinical">重试临床资料</button></view>
        <view class="detail-grid" wx:else>
          <view class="detail-row"><text class="detail-label">既往病史</text><text class="detail-value">{{clinical.medicalHistory || "未填写"}}</text></view>
          <view class="detail-row"><text class="detail-label">临床症状</text><text class="detail-value">{{clinical.clinicalSymptoms || "未填写"}}</text></view>
          <view class="detail-row"><text class="detail-label">临床诊断</text><text class="detail-value">{{clinical.diagnosis || "未填写"}}</text></view>
          <view class="detail-row"><text class="detail-label">用药情况</text><text class="detail-value">{{clinical.medication || "未填写"}}</text></view>
        </view>
      </view>

      <!-- Remark -->
      <view class="card petlis-card"
            role="region"
            aria-label="备注信息"
            wx:if="{{orderData.remark}}">
        <view class="card-title">
          <view class="title-line"></view>
          <text>备注</text>
        </view>
        <view class="remark-content">
          <text>{{orderData.remark}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="bottom-actions" wx:if="{{orderData.canResubmit}}">
      <button class="petlis-btn petlis-btn-primary resubmit-btn" bindtap="editAndResubmit">修改资料并重新提交</button>
    </view>
  </view>
</view>
