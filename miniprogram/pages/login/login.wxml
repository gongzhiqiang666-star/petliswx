<view class="login-page">
  <image class="hero-bg" src="/assets/brand/pet-dog-face.webp" mode="aspectFill" aria-hidden="true" />
  <view class="hero">
    <view class="hero-wordmark">纳博科临</view>
    <view class="hero-latin">LABOKLIN</view>
    <view class="hero-slogan">宠物医学检验协同平台</view>
    <view class="hero-sub">样本到报告 · 一站协同</view>
  </view>

  <view class="login-card">
    <view class="card-title">欢迎登录</view>
    <view class="card-hint">使用已审核的医生账号，继续送检与查看报告</view>

    <view class="field">
      <image class="field-icon" src="/assets/icons/brand-mine.png" mode="aspectFit" aria-hidden="true" />
      <input class="field-input" data-field="account" value="{{account}}" bindinput="field" placeholder="用户名或手机号" placeholder-class="field-placeholder" maxlength="100" />
    </view>
    <view class="field">
      <image class="field-icon" src="/assets/icons/brand-security.png" mode="aspectFit" aria-hidden="true" />
      <input class="field-input" data-field="password" value="{{password}}" bindinput="field" placeholder="密码" placeholder-class="field-placeholder" password maxlength="72" />
    </view>

    <view class="row" bindtap="remember">
      <checkbox checked="{{remember}}" color="#0D6E6E" />
      <text>保持登录（下次免输密码）</text>
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>

    <button class="login-button" type="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">登 录</button>
    <button class="wechat-button" disabled="{{busy}}" bindtap="wechat">
      <image class="wechat-icon" src="/assets/icons/brand-wechat.png" mode="aspectFit" aria-hidden="true" />
      <text>微信快捷登录</text>
    </button>

    <view class="links">
      <button class="link" bindtap="forgot">忘记密码</button>
      <text class="links-divider">|</text>
      <button class="link" bindtap="register">新医生注册</button>
    </view>
  </view>

  <view class="footer-hint">保持登录仅保留本机会话，不保存密码。新账号需提交医生资质并通过审核。</view>
</view>
