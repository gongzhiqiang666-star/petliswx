@import "../../styles/native-theme.wxss";

.home-page { min-height: 100vh; box-sizing: border-box; background: #F5F7F6; color: #1A1A1A; }
.home-hero { position: relative; box-sizing: border-box; padding: 24rpx 44rpx 88rpx; overflow: hidden; background: #0B3D3A; color: #EAF3F0; }
.home-hero .hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }
.home-hero::before { content: ''; position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; background: linear-gradient(135deg, rgba(11,61,58,.90) 0%, rgba(13,90,86,.62) 55%, rgba(13,110,110,.30) 100%); }
.home-hero .hero-top { position: relative; z-index: 2; }
.home-hero .hero-bg { z-index: 0; }
.hero-top { position: relative; display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.hero-identity { min-width: 0; flex: 1; }
.hero-eyebrow { display: flex; align-items: center; gap: 16rpx; color: #9FC4BC; font-size: 20rpx; line-height: 1.4; letter-spacing: 5rpx; }
.hero-logo { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.hero-hospital { margin-top: 20rpx; font-size: 46rpx; font-weight: 600; line-height: 1.35; letter-spacing: 1rpx; overflow-wrap: anywhere; }
.hero-greeting { margin-top: 16rpx; color: #B9D4CD; font-size: 24rpx; font-weight: 300; line-height: 1.5; letter-spacing: 1rpx; overflow-wrap: anywhere; }
.hero-qualification { display: inline-flex; align-items: center; gap: 12rpx; max-width: 100%; box-sizing: border-box; margin-top: 32rpx; padding: 10rpx 24rpx; border: 1rpx solid rgba(255,255,255,.22); border-radius: 40rpx; color: #C9E2DA; font-size: 20rpx; line-height: 1.4; letter-spacing: 2rpx; }
.qualification-dot { width: 10rpx; height: 10rpx; flex-shrink: 0; border-radius: 50%; background: #7FD8C5; }
.qualification-pending .qualification-dot { background: #E7B18E; }
.qualification-rejected .qualification-dot { background: #F2A4A4; }
.hero-actions { display: flex; align-items: center; flex-shrink: 0; }
.hero-bell-hit { width: 88rpx; height: 88rpx; margin: -10rpx -10rpx 0 0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.hero-bell { position: relative; width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.42); border-radius: 50%; background: rgba(255,255,255,.92); }
.hero-bell image { width: 32rpx; height: 32rpx; opacity: .9; }
.hero-unread-dot { position: absolute; top: 6rpx; right: 6rpx; width: 12rpx; height: 12rpx; box-sizing: border-box; border: 2rpx solid #0B3D3A; border-radius: 50%; background: #C96F45; }
.quick-card { position: relative; z-index: 1; display: flex; margin: -68rpx 32rpx 0; padding: 40rpx 12rpx; border: 1rpx solid #E7EEEA; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 2rpx 8rpx rgba(11,61,58,.04); }
.quick-entry-item { min-width: 0; min-height: 112rpx; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; }
.quick-icon { width: 42rpx; height: 42rpx; }
.quick-label { max-width: 100%; color: #33443F; font-size: 22rpx; line-height: 1.4; white-space: nowrap; }
.poster-banner { display: block; margin: 32rpx 32rpx 0; overflow: hidden; border: 1rpx solid #E7EEEA; border-radius: 20rpx; background: #0B3D3A; box-shadow: 0 2rpx 8rpx rgba(11,61,58,.04); }
.poster-banner image { display: block; width: 100%; height: 293rpx; }
.home-content { padding: 44rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); }
.home-section { margin-bottom: 48rpx; }
.notification-section { margin-bottom: 0; }
.section-heading { min-height: 44rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin: 0 8rpx 24rpx; }
.section-title { color: #1A1A1A; font-size: 30rpx; font-weight: 600; line-height: 1.5; letter-spacing: 1rpx; }
.section-note { color: #98A8A3; font-size: 22rpx; line-height: 1.5; }
.section-link { min-height: 88rpx; display: flex; align-items: center; margin: -22rpx 0; color: #98A8A3; font-size: 22rpx; line-height: 1.5; white-space: nowrap; }
.todo-row { display: flex; padding: 0 8rpx; }
.todo-item { min-width: 0; min-height: 104rpx; flex: 1; display: flex; flex-direction: column; justify-content: center; }
.todo-item + .todo-item { box-sizing: border-box; padding-left: 32rpx; border-left: 1rpx solid #E3EAE7; }
.todo-value { color: #0B3D3A; font-size: 52rpx; font-weight: 300; line-height: 1.2; letter-spacing: 1rpx; }
.todo-warn { color: #C96F45; }
.todo-label { margin-top: 8rpx; color: #85968F; font-size: 22rpx; line-height: 1.5; letter-spacing: 2rpx; }
.section-state { min-height: 88rpx; box-sizing: border-box; padding: 16rpx 8rpx; color: #85968F; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.section-error { color: #C96F45; }
.section-error .petlis-empty-text { color: #C96F45; }
.retry-link { min-height: 88rpx; display: inline-flex; align-items: center; margin: -16rpx 0 -16rpx 8rpx; padding: 0 12rpx; color: #0D6E6E; white-space: nowrap; }
.timeline { position: relative; margin-left: 8rpx; padding-left: 36rpx; }
.timeline::before { content: ''; position: absolute; top: 16rpx; bottom: 16rpx; left: 6rpx; width: 1rpx; background: #DCE6E2; }
.timeline-event { position: relative; min-height: 88rpx; box-sizing: border-box; padding: 0 0 36rpx; }
.timeline-event:last-child { padding-bottom: 0; }
.timeline-dot { position: absolute; top: 12rpx; left: -36rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #0D6E6E; box-shadow: 0 0 0 6rpx #E6F0EC; }
.event-warn .timeline-dot { background: #C96F45; box-shadow: 0 0 0 6rpx #F7EAE2; }
.event-muted .timeline-dot { background: #A9B8B2; box-shadow: 0 0 0 6rpx #EDF1EF; }
.timeline-pet { color: #263832; font-size: 28rpx; font-weight: 500; line-height: 1.5; letter-spacing: .6rpx; overflow-wrap: anywhere; }
.timeline-meta { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-top: 8rpx; color: #8A9B95; font-size: 22rpx; line-height: 1.5; }
.timeline-status { flex-shrink: 0; color: #0D6E6E; }
.event-warn .timeline-status { color: #C96F45; }
.event-muted .timeline-status { color: #8A9B95; }
.service-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.service-item { width: calc(50% - 10rpx); min-width: 0; min-height: 104rpx; display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; padding: 26rpx 28rpx; border: 1rpx solid #E7EEEA; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 2rpx 8rpx rgba(11,61,58,.04); color: #42534D; }
.service-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.service-label { min-width: 0; font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.notice-item { min-height: 88rpx; display: flex; align-items: flex-start; gap: 24rpx; box-sizing: border-box; padding: 24rpx 0; border-bottom: 1rpx solid #EBF0ED; }
.notice-item:last-child { border-bottom: 0; }
.notice-body { min-width: 0; flex: 1; }
.notice-title { color: #263832; font-size: 26rpx; font-weight: 500; line-height: 1.55; letter-spacing: .6rpx; overflow-wrap: anywhere; }
.notice-description { margin-top: 8rpx; color: #7E908A; font-size: 24rpx; font-weight: 300; line-height: 1.7; overflow-wrap: anywhere; }
.notice-time { flex-shrink: 0; color: #A3B2AC; font-size: 20rpx; line-height: 1.8; letter-spacing: 1rpx; white-space: nowrap; }
