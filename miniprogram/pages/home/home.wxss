/* pages/home/home.wxss */
/* ============================================
   Home 页面样式 - 全面优化版本
   ============================================ */

/* Page Container */
.home-page {
  width: 100%;
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* ============================================
   Hero Section - 头部区域
   ============================================ */
.hero-section {
  position: relative;
  padding: 100rpx 32rpx 320rpx;
  background: #2563EB;
  overflow: hidden;
}

/* Decorative Background */
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  filter: blur(60rpx);
}

.bg-circle-1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -80rpx;
  opacity: 0.6;
}

.bg-circle-2 {
  width: 240rpx;
  height: 240rpx;
  bottom: 80rpx;
  left: -60rpx;
  opacity: 0.5;
}

.bg-circle-3 {
  width: 180rpx;
  height: 180rpx;
  top: 200rpx;
  left: 100rpx;
  opacity: 0.4;
}

/* Hero Content */
.hero-content {
  position: relative;
  z-index: 1;
}

.hero-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
  letter-spacing: 2rpx;
  text-align: center;
}

.hero-subtitle {
  font-size: 28rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  letter-spacing: 1rpx;
  text-align: center;
}

/* ============================================
   Quick Actions - 快速操作卡片
   ============================================ */
.quick-actions-wrapper {
  position: relative;
  z-index: 10;
  margin-top: -200rpx;
  padding: 0 32rpx;
}

.quick-actions-card {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F0F0F0;
}

/* Action Item */
.action-item {
  position: relative;
  overflow: hidden;
  border-radius: 8rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.2s;
}

.action-item:last-child {
  margin-bottom: 0;
}

.action-item:active {
  opacity: 0.8;
}

/* Decorative Background */
.action-decorative {
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  filter: blur(40rpx);
}

/* Action Color Variants */
.action-item-violet {
  background: #8B5CF6;
}

.action-item-primary {
  background: #6366f1;
}

.action-item-success {
  background: #07C160;
}

/* Action Content */
.action-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.action-icon-box {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.action-icon {
  width: 52rpx;
  height: 52rpx;
}

.action-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.2;
  letter-spacing: 0.5rpx;
}

.action-desc {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.3;
}

/* Action Arrow */
.action-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.arrow-icon {
  font-size: 48rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1;
}

/* ============================================
   Notifications Section - 消息通知区域
   ============================================ */
.notifications-section {
  padding: 48rpx 32rpx 80rpx;
}

/* Section Header */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.section-title-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.2;
}

.title-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 12rpx;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

.view-all-link {
  font-size: 28rpx;
  font-weight: 400;
  color: #6366f1;
  line-height: 1.2;
}

/* Notifications List */
.notifications-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notification-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #f1f5f9;
  transition: all 0.2s ease;
}

.notification-card:active {
  background: #f8fafc;
  transform: scale(0.99);
}

/* Notification Icon */
.notification-icon-box {
  flex-shrink: 0;
}

.notification-icon-bg {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.2);
}

.notification-icon {
  width: 44rpx;
  height: 44rpx;
}

/* Notification Content */
.notification-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 8rpx;
}

.notification-text {
  font-size: 30rpx;
  font-weight: 400;
  color: #1f2937;
  line-height: 1.5;
  word-break: break-all;
}

.notification-time {
  font-size: 24rpx;
  font-weight: 400;
  color: #9ca3af;
  line-height: 1.3;
}

/* Notification Indicator */
.notification-indicator {
  width: 12rpx;
  height: 12rpx;
  background: #ef4444;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}

/* ============================================
   Empty State - 空状态
   ============================================ */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 32rpx;
}

.empty-illustration {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  border-radius: 50%;
}

.empty-image {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.4;
}

.empty-message {
  font-size: 28rpx;
  font-weight: 400;
  color: #9ca3af;
  line-height: 1.5;
}
