/* pages/report-list/report-list.wxss */

/* Search Bar */
.search-bar {
  margin: 16rpx 24rpx 24rpx 24rpx;
}

/* Report List */
.report-list {
  flex: 1;
  padding-bottom: 32rpx;
}

/* Loading State */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #666666;
  font-size: 28rpx;
}

/* Loading More State */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  color: #888888;
  font-size: 26rpx;
}

.loading-more text {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.loading-more text::before {
  content: '';
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E5E5E5;
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* No More Data */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  color: #888888;
  font-size: 26rpx;
}

/* Report Card */
.report-card {
  background: #fff;
  border-radius: 8rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F0F0F0;
  transition: all 0.2s;
}

.report-card:active {
  background-color: #F7F7F7;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.report-title {
  font-size: 32rpx;
  color: #000000;
  font-weight: 600;
  flex: 1;
  line-height: 1.4;
}

.status-badge {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-0.status-badge {
  background: #fef3c7;
  color: #d97706;
}

.status-1.status-badge {
  background: #d1fae5;
  color: #059669;
}

.report-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.4;
}

.info-value {
  font-size: 26rpx;
  color: #000000;
  font-weight: 500;
  line-height: 1.4;
}

.report-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.view-hint {
  font-size: 26rpx;
  color: #2563EB;
  line-height: 1.4;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon .icon {
  width: 96rpx;
  height: 96rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #888888;
  margin-bottom: 48rpx;
  line-height: 1.4;
}

.btn-primary {
  padding: 24rpx 64rpx;
  background: #2563EB;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* PDF Action Buttons */
.report-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-preview,
.btn-download {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  transition: all 0.2s;
  min-height: 68rpx;
  box-sizing: border-box;
}

.btn-preview {
  background: #2563EB;
  color: #fff;
}

.btn-preview::after {
  border: none;
}

.btn-preview:active {
  opacity: 0.8;
}

.btn-download {
  background: #2563EB;
  color: #fff;
}

.btn-download::after {
  border: none;
}

.btn-download:active {
  opacity: 0.8;
}

.btn-icon {
  width: 28rpx;
  height: 28rpx;
}
