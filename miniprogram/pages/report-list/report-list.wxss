@import "../../styles/petlis-3-overrides.wxss";

page {
  background: #F5F7F6;
}

.reports-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #F5F7F6;
  color: #263832;
}

.page-heading {
  margin-bottom: 16rpx;
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.page-heading::after {
  display: none;
}

.page-heading .ui-section-title {
  color: #0B3D3A;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.report-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-bar {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 88rpx;
  align-items: center;
  box-sizing: border-box;
  padding: 0 20rpx;
  border-radius: 20rpx;
  box-shadow: none;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 18rpx;
  opacity: .48;
}

.search-input {
  min-width: 0;
  height: 94rpx;
  flex: 1;
  color: #263832;
  font-size: 27rpx;
  line-height: 94rpx;
}

.search-placeholder {
  color: #A3B2AC;
  font-weight: 300;
}

.list-summary {
  flex-shrink: 0;
  margin: 0;
  color: #85968F;
  font-size: 22rpx;
  font-weight: 300;
  line-height: 1.5;
  white-space: nowrap;
}

.report-card {
  overflow: hidden;
  margin-bottom: 16rpx;
  padding: 28rpx;
  border: 1rpx solid #E3EAE7;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(11, 61, 58, .055);
}

.report-card.payment-restricted {
  border-color: #EFD8CA;
  background: #FFFCFA;
}

.report-content {
  min-height: 88rpx;
}

.report-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.report-title {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
  color: #0B3D3A;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.45;
  letter-spacing: .5rpx;
}

.status-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: #E6F0EC;
  color: #0D6E6E;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.5;
}

.status-badge.locked {
  background: #F7EAE2;
  color: #C96F45;
}

.test-title {
  margin: 8rpx 0 12rpx;
  overflow-wrap: anywhere;
  color: #42534D;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1.5;
}

.info-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 0;
  color: #98A8A3;
  font-size: 21rpx;
  font-weight: 300;
  line-height: 1.5;
}

.report-doctor {
  margin-top: 6rpx;
}

.info-value {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
  color: #52665F;
  font-size: 24rpx;
  text-align: right;
}

.detail-link {
  display: flex;
  min-height: 48rpx;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EBF0ED;
  color: #0D6E6E;
  font-size: 24rpx;
  line-height: 1.5;
}

.payment-restricted .detail-link {
  border-top-color: #F1E2D8;
  color: #C96F45;
}

.chevron-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: .6;
}

.report-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EBF0ED;
}

.ui-button {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.4;
}

.ui-button::after,
.load-more::after {
  border: 0;
}

.ui-button-primary {
  background: #0D6E6E;
  color: #FFFFFF;
}

.ui-button-secondary {
  border: 1rpx solid #DCE6E2;
  background: #FFFFFF;
  color: #0D6E6E;
}

.report-actions button.ui-button {
  flex: 0 0 auto;
  width: auto;
  margin: 0;
}

.ui-card.state {
  padding: 56rpx 32rpx;
  border: 1rpx solid #E3EAE7;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(11, 61, 58, .04);
}

.state.error .petlis-empty-text { color: #C96F45; }
.state {
  color: #85968F;
  font-size: 25rpx;
  font-weight: 300;
  line-height: 1.7;
  text-align: center;
}

.state button {
  margin-top: 28rpx;
}

.empty-icon {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  margin-bottom: 12rpx;
  color: #263832;
  font-size: 30rpx;
  font-weight: 500;
}

.state .ui-muted {
  color: #8A9B95;
  font-size: 24rpx;
}

.error {
  color: #A4563F;
}

.end-note {
  padding: 30rpx;
  color: #A3B2AC;
  font-size: 23rpx;
  font-weight: 300;
  text-align: center;
}

.load-more {
  min-height: 88rpx;
  background: transparent;
  color: #0D6E6E;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 88rpx;
}
