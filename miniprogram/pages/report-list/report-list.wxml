<view class="ui-page reports-page">
  <view class="report-tools">
    <view class="search-bar" role="search" aria-label="搜索检测报告">
      <image src="/assets/icons/brand-search.png" class="search-icon" mode="aspectFit" aria-hidden="true" />
      <input class="search-input petlis-input" placeholder="搜索宠物或项目" placeholder-class="search-placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" />
    </view>
    <view class="list-summary">{{searchKeyword ? '找到 ' + totalCount + ' 份' : '共 ' + totalCount + ' 份'}}</view>
  </view>
  <view wx:if="{{loading}}" class="state" role="status">正在加载报告…</view>
  <view wx:else>
    <view wx:for="{{filteredReports}}" wx:key="reportId" class="ui-card petlis-card report-card {{item.paymentRestricted ? 'payment-restricted' : ''}}">
      <view class="report-content" bindtap="onViewReport" data-id="{{item.reportId}}" role="button" aria-label="查看{{item.animalName}}的报告详情">
        <view class="report-header">
          <text class="report-title">{{item.animalName || '未填写宠物名称'}}</text>
          <text class="status-badge {{item.paymentRestricted ? 'locked' : ''}}">{{item.paymentRestricted ? '待支付' : item.statusLabel}}</text>
        </view>
        <view class="test-title">{{item.testTypeName}}</view>
        <view class="info-row report-meta">
          <text>采样 {{item.samplingDate || '未提供'}}</text>
          <text>报告 {{item.reportDate || '未提供'}}</text>
        </view>
        <view wx:if="{{item.doctorName}}" class="info-row report-doctor">医师 {{item.doctorName}}</view>
        <view class="detail-link" wx:if="{{item.paymentRestricted}}">
          <text>订单未支付，查看支付指引</text>
          <image src="/assets/icons/brand-chevron-right.png" class="chevron-icon" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
      <view class="report-actions" wx:if="{{item.securePdfUrl && !item.paymentRestricted}}">
        <button class="ui-button petlis-btn petlis-btn-primary ui-button-primary" bindtap="onPreviewPDF" data-url="{{item.securePdfUrl}}">预览报告</button>
        <button class="ui-button petlis-btn petlis-btn-outline ui-button-secondary" bindtap="onDownloadPDF" data-url="{{item.securePdfUrl}}">下载报告</button>
      </view>
    </view>

    <view wx:if="{{error}}" class="ui-card petlis-card petlis-empty state error" role="alert">
      <image src="/assets/icons/brand-empty.png" mode="aspectFit" />
      <view class="petlis-empty-text">{{error}}</view>
      <button class="ui-button petlis-btn petlis-btn-outline ui-button-secondary" bindtap="retry">重新加载</button>
    </view>
    <view wx:elif="{{!filteredReports.length}}" class="ui-card petlis-card petlis-empty state">
      <image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" aria-hidden="true" />
      <view class="empty-title">{{searchKeyword ? '未找到匹配的报告' : '暂无检测报告'}}</view>
      <view class="ui-muted">{{searchKeyword ? '试试宠物名称或检测项目中的其他关键词。' : '报告生成后会显示在这里，并通过消息提醒。'}}</view>
      <button wx:if="{{!searchKeyword}}" class="ui-button petlis-btn petlis-btn-primary ui-button-primary" bindtap="onNewAppointment">我要送检</button>
    </view>
    <view wx:if="{{loadingMore}}" class="state" role="status">正在加载更多…</view>
    <button wx:elif="{{hasMore && !error}}" class="load-more petlis-btn petlis-btn-outline" bindtap="onScrollToLower">加载更多报告</button>
    <view wx:elif="{{!hasMore && filteredReports.length}}" class="end-note">已显示全部报告</view>
  </view>
</view>
