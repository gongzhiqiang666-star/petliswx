<view class="page"><view class="card petlis-list-card"><view>个人账户余额</view><view class="balance">¥{{balance===null?'—':balance}}</view><view class="hint">本次充值只进入个人账户，不进入医院月结账户。</view><view class="form-item"><view class="form-label">充值金额（元）</view><input class="petlis-input" value="{{amount}}" bindinput="amount" type="digit" placeholder="请输入充值金额" maxlength="8"/></view></view><view wx:if="{{error}}" class="error petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">{{error}}</view><button class="petlis-btn petlis-btn-outline" bindtap="retry">刷新充值记录</button></view><view class="title" style="font-size:32rpx">充值记录</view><view wx:for="{{items}}" wx:key="paymentNo" class="card petlis-list-card"><view class="line"><text>¥{{item.amount}}</text><text class="badge">{{item.status==='paid'?'已到账':item.status==='pending'?'待付款':'已关闭'}}</text></view><view class="meta">{{item.createdAt}}</view><view class="meta">单号：{{item.paymentNo}}</view><view wx:if="{{item.status==='pending'}}" class="row card-actions"><button class="petlis-btn petlis-btn-primary" data-no="{{item.paymentNo}}" bindtap="resume" disabled="{{busy}}">继续支付</button><button class="petlis-btn petlis-btn-outline" data-no="{{item.paymentNo}}" bindtap="close" disabled="{{busy}}">关闭</button></view></view><view wx:if="{{!busy && !items.length && !error}}" class="empty petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">暂无充值记录</view></view><button wx:if="{{more}}" class="petlis-btn petlis-btn-outline" bindtap="more" loading="{{busy}}">加载更多</button><view class="bottom-actions"><button class="petlis-btn petlis-btn-primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">确认金额并充值</button></view></view>
