/* pages/mine/mine.wxss */
/* 微信原生简洁风格 */

/* ============= 页面容器 ============= */
.page {
  background: #F7F7F7;
  min-height: 100vh;
  padding-bottom: 32rpx;
}

/* ============= 用户卡片 ============= */
.user-card {
  position: relative;
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 32rpx 24rpx;
  border-top: 1rpx solid #E5E5E5;
  border-bottom: 1rpx solid #E5E5E5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.user-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar-container {
  position: relative;
  flex-shrink: 0;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #2563EB;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.avatar-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.avatar-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 28rpx;
  height: 28rpx;
  background: #2563EB;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  color: #000000;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.user-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #888888;
  line-height: 1.4;
}

.user-id {
  color: #2563EB;
  font-weight: 500;
}

.user-divider {
  color: #CCCCCC;
}

.user-mobile {
  color: #888888;
}

/* ============= 内容区域 ============= */
.content {
  position: relative;
}

/* ============= 快捷操作入口 ============= */
.quick-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border-top: 1rpx solid #E5E5E5;
  border-bottom: 1rpx solid #E5E5E5;
  transition: background-color 0.2s;
}

.quick-entry:active {
  background-color: #F7F7F7;
}

.quick-entry-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.quick-entry-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: #2563EB;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}

.quick-entry-icon {
  width: 36rpx;
  height: 36rpx;
}

.quick-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  background: #FA5151;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.quick-entry-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.quick-entry-title {
  font-size: 30rpx;
  color: #000000;
  font-weight: 500;
  line-height: 1.4;
  display: block;
}

.quick-entry-desc {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.4;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-entry-arrow {
  font-size: 48rpx;
  color: #CCCCCC;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* ============= 区块样式 ============= */
.section {
  margin: 0 24rpx 24rpx;
}

.hospital-section {
  margin-bottom: 24rpx;
}

.hospital-card {
  background: #FFFFFF;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  border-top: 1rpx solid #E5E5E5;
  border-bottom: 1rpx solid #E5E5E5;
}

.hospital-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.hospital-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: #2563EB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hospital-icon {
  width: 36rpx;
  height: 36rpx;
}

.hospital-info {
  flex: 1;
  min-width: 0;
}

.hospital-name {
  font-size: 30rpx;
  color: #000000;
  font-weight: 500;
  margin-bottom: 8rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.hospital-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hospital-place {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.hospital-arrow {
  flex-shrink: 0;
  margin-left: 8rpx;
}

.arrow-icon {
  font-size: 48rpx;
  color: #CCCCCC;
  font-weight: 300;
}

/* ============= 设置列表 ============= */
.settings-section {
  background: #FFFFFF;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  border-top: 1rpx solid #E5E5E5;
  border-bottom: 1rpx solid #E5E5E5;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  transition: background-color 0.2s;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: #F7F7F7;
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.setting-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.setting-icon-blue {
  background: #F0F9FF;
}

.setting-icon-green {
  background: #F0F9FF;
}

.setting-icon-purple {
  background: #F0F9FF;
}

.setting-icon {
  width: 32rpx;
  height: 32rpx;
}

.setting-label {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
  line-height: 1.4;
}

.setting-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
  font-weight: 300;
  flex-shrink: 0;
}

/* ============= 退出登录 ============= */
.logout-section {
  margin: 32rpx 24rpx 24rpx;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  border: 1rpx solid #E5E5E5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: background-color 0.2s;
}

.logout-btn:active {
  background: #F7F7F7;
}

.logout-icon {
  width: 40rpx;
  height: 40rpx;
}

.logout-text {
  font-size: 30rpx;
  color: #FA5151;
  font-weight: 500;
  line-height: 1.4;
}

/* ============= 版本信息 ============= */
.version-info {
  text-align: center;
  padding: 32rpx 24rpx 64rpx;
}

.version-text {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.version-number {
  font-size: 24rpx;
  color: #CCCCCC;
  font-weight: 500;
  line-height: 1.4;
}
