@import "../../styles/native-theme.wxss";

.mine-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); background: #F5F7F6; color: #1A1A1A; }
.mine-hero { position: relative; box-sizing: border-box; padding: 24rpx 44rpx 80rpx; overflow: hidden; background: #0B3D3A; color: #EAF3F0; }
.mine-hero .hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }
.mine-hero::before { content: ''; position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; background: linear-gradient(135deg, rgba(11,61,58,.90) 0%, rgba(13,90,86,.62) 55%, rgba(13,110,110,.30) 100%); }
.mine-hero .mine-eyebrow, .mine-hero .profile-row { position: relative; z-index: 2; }
.mine-hero .hero-bg { z-index: 0; }
.mine-eyebrow { position: relative; color: #9FC4BC; font-size: 20rpx; line-height: 1.4; letter-spacing: 5rpx; }
.profile-row { position: relative; display: flex; align-items: center; gap: 28rpx; margin-top: 40rpx; }
.user-avatar { width: 112rpx; height: 112rpx; flex-shrink: 0; box-sizing: border-box; border: 2rpx solid rgba(255,255,255,.26); border-radius: 50%; background: rgba(255,255,255,.10); }
.user-info { min-width: 0; flex: 1; }
.user-name { color: #F2F8F5; font-size: 40rpx; font-weight: 600; line-height: 1.4; letter-spacing: 1rpx; overflow-wrap: anywhere; }
.user-meta { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; color: #B9D4CD; font-size: 22rpx; font-weight: 300; line-height: 1.5; overflow-wrap: anywhere; }
.meta-divider { padding: 0 4rpx; }
.user-hospital { margin-top: 12rpx; color: #9FC4BC; font-size: 24rpx; font-weight: 300; line-height: 1.5; overflow-wrap: anywhere; }
.wallet-card { position: relative; z-index: 1; min-height: 136rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; box-sizing: border-box; margin: -48rpx 32rpx 0; padding: 32rpx; border: 1rpx solid #E7EEEA; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 2rpx 8rpx rgba(11,61,58,.04); }
.wallet-main { min-width: 0; flex: 1; }
.wallet-label { color: #85968F; font-size: 22rpx; line-height: 1.5; letter-spacing: 1rpx; }
.wallet-balance { margin-top: 8rpx; color: #0B3D3A; font-size: 52rpx; font-weight: 300; line-height: 1.25; overflow-wrap: anywhere; }
.wallet-state { min-height: 56rpx; display: flex; align-items: center; flex-wrap: wrap; margin-top: 8rpx; color: #85968F; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.wallet-error { color: #C96F45; }
.wallet-error .petlis-empty-text { color: #C96F45; }
.wallet-retry { min-height: 88rpx; display: inline-flex; align-items: center; margin: -16rpx 0 -16rpx 8rpx; padding: 0 12rpx; color: #0D6E6E; white-space: nowrap; }
.recharge-button { min-width: 144rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-sizing: border-box; padding: 16rpx 28rpx; border: 1rpx solid #0D6E6E; border-radius: 44rpx; background: #FFFFFF; color: #0D6E6E; font-size: 24rpx; line-height: 1.4; }
.menu-card { margin: 32rpx; padding: 0 28rpx; box-sizing: border-box; border: 1rpx solid #E7EEEA; border-radius: 20rpx; background: #FFFFFF; box-shadow: 0 2rpx 8rpx rgba(11,61,58,.04); }
.menu-item { position: relative; min-height: 104rpx; box-sizing: border-box; gap: 20rpx; border-bottom: 1rpx solid #EBF0ED; color: #33443F; }
.menu-item:last-child { border-bottom: 0; }
.menu-item:active, .menu-item-active { background: #F5F8F7; }
.menu-icon { position: relative; width: 72rpx; height: 72rpx; border-radius: 16rpx; background: #F0F6F4; }
.menu-icon image { width: 34rpx; height: 34rpx; }
.menu-label { min-width: 0; flex: 1; font-size: 28rpx; font-weight: 400; line-height: 1.5; overflow-wrap: anywhere; }
.menu-hospital { min-width: 0; flex: 1; padding: 16rpx 0; }
.menu-hospital .menu-label { display: block; }
.menu-description { display: block; margin-top: 4rpx; color: #98A8A3; font-size: 22rpx; font-weight: 300; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.menu-chevron { width: 28rpx; height: 28rpx; flex-shrink: 0; opacity: .65; }
.unread-badge { position: absolute; top: -10rpx; right: -12rpx; min-width: 32rpx; height: 32rpx; box-sizing: border-box; padding: 0 8rpx; border: 2rpx solid #FFFFFF; border-radius: 18rpx; background: #C96F45; color: #FFFFFF; font-size: 20rpx; font-weight: 500; line-height: 28rpx; text-align: center; }
.logout-item { color: #B55757; }
.logout-icon { background: #FBF2F1; }
