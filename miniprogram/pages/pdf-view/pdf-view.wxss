@import "../../styles/petlis-3-overrides.wxss";
/* pages/pdf-view/pdf-view.wxss */
web-view {
  width: 100%;
  height: 100vh;
}

.pdf-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(144rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
  color: #33443F;
  text-align: center;
}

.pdf-content {
  padding-top: 24rpx;
}

.bottom-actions {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 16rpx 24rpx calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E3EAE7;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 8rpx rgba(11, 61, 58, 0.04);
}

.pdf-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 28rpx;
}

.pdf-description {
  font-size: 27rpx;
  font-weight: 300;
  line-height: 1.8;
}

.pdf-error {
  margin: 24rpx 0;
  color: #AC3535;
  font-size: 25rpx;
  line-height: 1.6;
}

.pdf-open {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border-radius: 24rpx;
  background: #0D6E6E;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 88rpx;
}

.pdf-open::after {
  border: 0;
}
