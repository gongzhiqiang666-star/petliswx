<view class="page"><view class="tabs petlis-filters"><button wx:for="{{tabs}}" wx:key="id" class="petlis-filter-item {{tab===item.id?'active':''}}" data-id="{{item.id}}" bindtap="tab" disabled="{{busy}}">{{item.name}}</button></view><view wx:if="{{error}}" class="error">{{error}}<button class="petlis-btn petlis-btn-outline" bindtap="retry">重试</button></view><view wx:if="{{!busy && !items.length && !error}}" class="empty petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">当前没有待处理申请</view></view><view wx:for="{{items}}" wx:key="key" class="card petlis-list-card"><view>{{item.nickname || item.doctorName || item.orderNo || ('申请 '+item.key)}}</view><view class="meta">{{item.hospitalName || ''}} {{item.mobile || ''}} {{item.title || ''}}</view><view wx:if="{{item.amount!==undefined}}">金额：¥{{item.amount}}</view><view class="meta" wx:if="{{item.requestedText}}">{{item.requestedText}}</view><button wx:for="{{item.files}}" wx:for-item="file" wx:key="*this" class="petlis-btn petlis-btn-outline" data-url="{{file}}" bindtap="file">查看资质 {{index+1}}</button><view wx:if="{{tab!=='invoices'}}"><button wx:if="{{activeId!==item.key}}" class="petlis-btn petlis-btn-primary" data-id="{{item.key}}" bindtap="edit">处理申请</button><view wx:else><view class="form-item"><view class="form-label">审核意见（驳回时必填）</view><textarea class="petlis-input" value="{{reason}}" bindinput="reason" placeholder="请输入审核意见" maxlength="500"/></view><view class="row"><button class="petlis-btn petlis-btn-primary" disabled="{{busy}}" data-id="{{item.key}}" data-approved="yes" bindtap="decide">通过</button><button class="petlis-btn petlis-btn-danger" disabled="{{busy}}" data-id="{{item.key}}" data-approved="no" bindtap="decide">驳回</button></view></view></view><view wx:else><view class="meta">{{item.profileSnapshot}}</view><button wx:if="{{activeId!==item.key}}" class="petlis-btn petlis-btn-primary" data-id="{{item.key}}" bindtap="edit">处理发票</button><view wx:else><view class="form-item"><view class="form-label">电子发票地址</view><input class="petlis-input" value="{{invoiceUrl}}" bindinput="invoice" placeholder="请输入电子发票 HTTPS 地址"/></view><view class="form-item"><view class="form-label">驳回原因（驳回时必填）</view><textarea class="petlis-input" value="{{reason}}" bindinput="reason" placeholder="请输入驳回原因" maxlength="500"/></view><view class="row"><button class="petlis-btn petlis-btn-primary" data-id="{{item.key}}" data-approved="yes" disabled="{{busy}}" bindtap="issue">确认已开具</button><button class="petlis-btn petlis-btn-danger" data-id="{{item.key}}" data-approved="no" disabled="{{busy}}" bindtap="issue">驳回</button></view></view></view></view><button wx:if="{{hasMore}}" class="petlis-btn petlis-btn-outline" loading="{{busy}}" bindtap="more">加载更多</button><view class="links"><button class="petlis-btn petlis-btn-outline" bindtap="logout"><image class="button-icon" src="/assets/icons/brand-logout.png" mode="aspectFit" />退出登录</button></view></view>