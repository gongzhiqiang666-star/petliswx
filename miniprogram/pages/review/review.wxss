@import "../../styles/native-theme.wxss";
page{background:#F5F7F6;color:#263d37}.page{padding:24rpx 32rpx}.title{font-size:42rpx;font-weight:600;margin-bottom:16rpx}.hint{color:#66766f;font-size:26rpx;line-height:1.6;margin:16rpx 0 32rpx}.card{background:white;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}input{padding:24rpx 0;border-bottom:1rpx solid #e8ece8}button{margin-top:24rpx;font-size:30rpx}button[type=primary]{background:#26745e}.card.petlis-list-card{border-radius:20rpx}.tabs.petlis-filters{gap:0}.error{color:#C96F45;margin:24rpx 0}button.petlis-btn-primary{background:var(--petlis-primary);color:#fff}button.petlis-btn-outline{background:#fff;color:var(--petlis-primary);border-color:var(--petlis-primary)}button.petlis-btn-danger{background:#FA5151;color:#fff}textarea.petlis-input{height:auto;min-height:160rpx;padding:24rpx}.row{display:flex;gap:16rpx;align-items:center;margin-top:20rpx}.tabs{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:24rpx}.tabs button{font-size:26rpx;margin:0}.meta{font-size:26rpx;color:#66766f;margin:10rpx 0}.empty{text-align:center;padding:60rpx 0;color:#66766f}textarea{background:#f8faf8;width:100%;box-sizing:border-box;padding:16rpx;margin-top:16rpx;border-radius:12rpx}.links{margin-top:40rpx;text-align:center}.empty-icon{display:block;width:96rpx;height:96rpx;margin:0 auto 20rpx}.button-icon{width:28rpx;height:28rpx;margin-right:12rpx;vertical-align:middle}.form-item{padding:20rpx 0;border-bottom:1rpx solid #F0F0F0}.form-item:last-child{border-bottom:0}.form-label{display:block;margin-bottom:12rpx;color:#1A1A1A;font-size:28rpx;font-weight:500;line-height:1.4}.form-item .petlis-input{margin-top:0}.error,.error .petlis-empty-text{color:#C96F45;font-size:22rpx}