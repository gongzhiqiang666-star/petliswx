<!--pages/pet-add/pet-add.wxml-->
<!-- 宠物建档 - 一屏紧凑版 -->
<view class="pet-add-page-compact">
  <!-- 极简标题 -->
  <view class="page-title-compact">
    <text class="title-text">宠物建档</text>
    <text class="title-desc">填写宠物基本信息</text>
  </view>

  <!-- 紧凑双列表单 -->
  <view class="form-grid">
    <!-- 第一列 -->
    <view class="form-column">
      <!-- 宠物中文名 -->
      <view class="form-field-compact">
        <text class="field-label">宠物中文名</text>
        <input
          class="field-input-compact {{formData.animalName ? 'has-value' : ''}}"
          placeholder="旺旺"
          value="{{formData.animalName}}"
          bindinput="onInputChange"
          data-field="animalName"
        />
      </view>

      <!-- 物种 -->
      <view class="form-field-compact">
        <text class="field-label">物种</text>
        <view class="field-selector-compact" bindtap="showSpeciesSelector">
          <text class="selector-text-compact {{selectedAnimalName ? '' : 'placeholder'}}">
            {{selectedAnimalName || '选择'}}
          </text>
          <text class="selector-arrow">▼</text>
        </view>
      </view>

      <!-- 性别 -->
      <view class="form-field-compact">
        <text class="field-label">性别</text>
        <view class="gender-selector-compact">
          <view
            class="gender-option-compact {{formData.dictSexId === 1 ? 'selected' : ''}}"
            bindtap="onGenderChange"
            data-id="1"
          >
            <text class="gender-icon">♂</text>
          </view>
          <view
            class="gender-option-compact {{formData.dictSexId === 2 ? 'selected' : ''}}"
            bindtap="onGenderChange"
            data-id="2"
          >
            <text class="gender-icon">♀</text>
          </view>
        </view>
      </view>

      <!-- 出生日期 -->
      <view class="form-field-compact">
        <text class="field-label">出生日期</text>
        <picker
          mode="date"
          value="{{formData.birthday}}"
          bindchange="onBirthdayChange"
          class="field-picker-compact"
        >
          <text class="picker-text-compact {{formData.birthday ? '' : 'placeholder'}}">
            {{formData.birthday || '选择日期'}}
          </text>
        </picker>
      </view>

      <!-- 芯片号 -->
      <view class="form-field-compact">
        <text class="field-label">芯片号</text>
        <input
          class="field-input-compact"
          placeholder="选填"
          value="{{formData.chipNo}}"
          bindinput="onInputChange"
          data-field="chipNo"
        />
      </view>
    </view>

    <!-- 第二列 -->
    <view class="form-column">
      <!-- 宠物英文名 -->
      <view class="form-field-compact">
        <text class="field-label">英文名</text>
        <input
          class="field-input-compact {{formData.animalNameEn ? 'has-value' : ''}}"
          placeholder="Wangwang"
          value="{{formData.animalNameEn}}"
          bindinput="onInputChange"
          data-field="animalNameEn"
        />
      </view>

      <!-- 品种 -->
      <view class="form-field-compact">
        <text class="field-label">品种</text>
        <view class="field-selector-compact" bindtap="onSelectBreed">
          <text class="selector-text-compact {{selectedBreed ? '' : 'placeholder'}}">
            {{selectedBreed ? selectedBreed.varietyCn : '选择'}}
          </text>
          <text class="selector-arrow">▶</text>
        </view>
      </view>

      <!-- 年龄 -->
      <view class="form-field-compact">
        <text class="field-label">年龄</text>
        <input
          class="field-input-compact field-readonly"
          placeholder="自动计算"
          value="{{formData.age}}"
          disabled
        />
      </view>

      <!-- 主人姓名 -->
      <view class="form-field-compact">
        <text class="field-label">主人姓名</text>
        <input
          class="field-input-compact {{formData.ownerName ? 'has-value' : ''}}"
          placeholder="李四"
          value="{{formData.ownerName}}"
          bindinput="onInputChange"
          data-field="ownerName"
        />
      </view>

      <!-- 拼音 -->
      <view class="form-field-compact">
        <text class="field-label">拼音</text>
        <input
          class="field-input-compact field-readonly"
          placeholder="自动"
          value="{{formData.ownerNameEn}}"
          disabled
        />
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions-compact">
    <button class="action-btn-compact btn-cancel" bindtap="onBack">取消</button>
    <button class="action-btn-compact btn-primary {{isSubmitting ? 'submitting' : ''}}" bindtap="onSave">
      {{isSubmitting ? '保存中...' : '保存档案'}}
    </button>
  </view>

  <!-- 物种选择器弹窗 -->
  <popup-selector
    visible="{{showSpeciesSelector}}"
    title="选择物种"
    items="{{speciesList}}"
    selectedId="{{formData.infoAnimalId}}"
    itemIdKey="infoAnimalId"
    itemNameKey="animalName"
    itemNameEnKey="animalNameEn"
    searchPlaceholder="搜索物种名称"
    emptyText="暂无物种数据"
    bindselect="onSpeciesSelect"
    bindclose="hideSpeciesSelector"
  />
</view>
