<!--pages/pet-add/pet-add.wxml-->
<!-- 宠物建档 - Organic Biophilic 自然有机风格 -->
<view class="pet-add-page">
  <!-- 自然主题头部 -->
  <view class="nature-header">
    <view class="nature-decoration">
      <view class="leaf-shape"></view>
      <view class="leaf-shape leaf-2"></view>
    </view>
    <view class="header-content">
      <text class="nature-title">宠物档案</text>
      <text class="nature-subtitle">自然生长 · 陪伴记录</text>
    </view>
  </view>

  <!-- 表单内容 -->
  <scroll-view class="nature-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 有机卡片 - 基本信息 -->
    <view class="organic-card">
      <view class="organic-header">
        <view class="organic-icon">🌱</view>
        <text class="organic-title">基本信息</text>
      </view>

      <view class="field-row">
        <text class="field-key">宠物中文名</text>
        <input
          class="organic-input"
          placeholder="例如：旺旺"
          value="{{formData.animalName}}"
          bindinput="onInputChange"
          data-field="animalName"
        />
      </view>

      <view class="field-row">
        <text class="field-key">英文名</text>
        <input
          class="organic-input"
          placeholder="例如：Wangwang"
          value="{{formData.animalNameEn}}"
          bindinput="onInputChange"
          data-field="animalNameEn"
        />
      </view>

      <view class="field-row">
        <text class="field-key">物种</text>
        <view class="organic-btn" bindtap="showSpeciesSelector">
          <text class="organic-btn-text {{selectedAnimalName ? '' : 'btn-placeholder'}}">
            {{selectedAnimalName || '选择物种'}}
          </text>
          <text class="btn-arrow">→</text>
        </view>
      </view>

      <view class="field-row">
        <text class="field-key">品种</text>
        <view class="organic-btn" bindtap="onSelectBreed">
          <text class="organic-btn-text {{selectedBreed ? '' : 'btn-placeholder'}}">
            {{selectedBreed ? selectedBreed.varietyCn : '选择品种'}}
          </text>
          <text class="btn-arrow">→</text>
        </view>
      </view>
    </view>

    <!-- 有机卡片 - 特征信息 -->
    <view class="organic-card card-green">
      <view class="organic-header">
        <view class="organic-icon">🍃</view>
        <text class="organic-title">特征信息</text>
      </view>

      <view class="field-row">
        <text class="field-key">性别</text>
        <view class="nature-chips">
          <view
            class="nature-chip {{formData.dictSexId === 1 ? 'chip-selected' : ''}}"
            bindtap="onGenderChange"
            data-id="1"
          >
            <text class="chip-text">♂ 公</text>
          </view>
          <view
            class="nature-chip {{formData.dictSexId === 2 ? 'chip-selected' : ''}}"
            bindtap="onGenderChange"
            data-id="2"
          >
            <text class="chip-text">♀ 母</text>
          </view>
        </view>
      </view>

      <view class="field-row">
        <text class="field-key">出生日期</text>
        <picker mode="date" value="{{formData.birthday}}" bindchange="onBirthdayChange">
          <view class="organic-btn">
            <text class="organic-btn-text {{formData.birthday ? '' : 'btn-placeholder'}}">
              {{formData.birthday || '选择日期'}}
            </text>
            <text class="btn-arrow">→</text>
          </view>
        </picker>
      </view>

      <view class="field-row">
        <text class="field-key">年龄</text>
        <input
          class="organic-input input-readonly"
          placeholder="自动计算"
          value="{{formData.age}}"
          disabled
        />
      </view>

      <view class="field-row">
        <text class="field-key">芯片号</text>
        <input
          class="organic-input"
          placeholder="选填"
          value="{{formData.chipNo}}"
          bindinput="onInputChange"
          data-field="chipNo"
        />
      </view>
    </view>

    <!-- 有机卡片 - 主人信息 -->
    <view class="organic-card card-warm">
      <view class="organic-header">
        <view class="organic-icon">🌻</view>
        <text class="organic-title">主人信息</text>
      </view>

      <view class="field-row">
        <text class="field-key">姓名</text>
        <input
          class="organic-input"
          placeholder="请输入姓名"
          value="{{formData.ownerName}}"
          bindinput="onInputChange"
          data-field="ownerName"
        />
      </view>

      <view class="field-row">
        <text class="field-key">拼音</text>
        <input
          class="organic-input input-readonly"
          placeholder="自动生成"
          value="{{formData.ownerNameEn}}"
          disabled
        />
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="nature-spacer"></view>
  </scroll-view>

  <!-- 自然底部栏 -->
  <view class="nature-bar">
    <button class="nature-btn btn-ghost" bindtap="onBack">
      <text class="nature-btn-text">取消</text>
    </button>
    <button class="nature-btn btn-nature {{isSubmitting ? 'btn-loading' : ''}}" bindtap="onSave">
      <text class="nature-btn-text">{{isSubmitting ? '保存中...' : '保存档案'}}</text>
    </button>
  </view>

  <!-- 物种选择器弹窗 -->
  <popup-selector
    visible="{{showSpeciesSelector}}"
    title="选择物种"
    items="{{speciesList}}"
    selectedId="{{formData.infoAnimalId}}"
    itemIdKey="infoAnimalId"
    itemNameKey="animalName"
    itemNameEnKey="animalNameEn"
    searchPlaceholder="搜索物种名称"
    emptyText="暂无物种数据"
    bindselect="onSpeciesSelect"
    bindclose="hideSpeciesSelector"
  />
</view>
