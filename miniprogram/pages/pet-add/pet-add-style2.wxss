/* pages/pet-add/pet-add.wxss */
/* Organic Biophilic - 自然有机风格 */

/* ============================================
   页面容器
   ============================================ */
.pet-add-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F0FDF4 0%, #FEF9F0 100%);
  display: flex;
  flex-direction: column;
}

/* ============================================
   自然主题头部
   ============================================ */
.nature-header {
  position: relative;
  padding: 48rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #86EFAC 0%, #A7F3D0 100%);
  overflow: hidden;
}

.nature-decoration {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  opacity: 0.15;
}

.leaf-shape {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  background: #065F46;
  border-radius: 50% 0 50% 50%;
  top: 20rpx;
  right: 40rpx;
  transform: rotate(45deg);
}

.leaf-shape.leaf-2 {
  width: 80rpx;
  height: 80rpx;
  top: 120rpx;
  right: 160rpx;
  background: #047857;
  border-radius: 50% 50% 0 50%;
  transform: rotate(-30deg);
}

.header-content {
  position: relative;
  z-index: 2;
}

.nature-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #064E3B;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.nature-subtitle {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #065F46;
  line-height: 1.3;
  opacity: 0.9;
}

/* ============================================
   滚动内容
   ============================================ */
.nature-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx 20rpx;
}

/* ============================================
   有机卡片
   ============================================ */
.organic-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 139, 34, 0.08);
  border: 2rpx solid #F0FDF4;
  position: relative;
  overflow: hidden;
}

.organic-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #86EFAC 0%, #A7F3D0 100%);
  border-radius: 28rpx 28rpx 0 0;
}

.card-green::before {
  background: linear-gradient(90deg, #86EFAC 0%, #34D399 100%);
}

.card-warm::before {
  background: linear-gradient(90deg, #FDE68A 0%, #FBBF24 100%);
}

.organic-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.organic-icon {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.organic-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #065F46;
}

/* ============================================
   字段行
   ============================================ */
.field-row {
  margin-bottom: 20rpx;
}

.field-row:last-child {
  margin-bottom: 0;
}

.field-key {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #064E3B;
  line-height: 1.3;
  margin-bottom: 10rpx;
}

/* ============================================
   有机输入框
   ============================================ */
.organic-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #064E3B;
  background: #F0FDF4;
  border: 2rpx solid #D1FAE5;
  border-radius: 16rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.organic-input:focus {
  background: #ffffff;
  border-color: #86EFAC;
  outline: none;
  box-shadow: 0 0 0 4rpx rgba(134, 239, 172, 0.15);
}

.organic-input::placeholder {
  color: #6EE7B7;
}

.input-readonly {
  background: #FAFAF9;
  color: #78716C;
  border-color: #E7E5E4;
}

/* ============================================
   有机按钮
   ============================================ */
.organic-btn {
  height: 88rpx;
  padding: 0 20rpx;
  background: #F0FDF4;
  border: 2rpx solid #D1FAE5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.organic-btn:active {
  background: #ffffff;
  border-color: #86EFAC;
}

.organic-btn-text {
  flex: 1;
  font-size: 28rpx;
  color: #064E3B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.organic-btn-text.btn-placeholder {
  color: #6EE7B7;
}

.btn-arrow {
  font-size: 28rpx;
  color: #6EE7B7;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ============================================
   自然芯片
   ============================================ */
.nature-chips {
  display: flex;
  gap: 12rpx;
}

.nature-chip {
  flex: 1;
  height: 88rpx;
  background: #F0FDF4;
  border: 2rpx solid #D1FAE5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nature-chip:active {
  transform: scale(0.98);
}

.chip-selected {
  background: linear-gradient(135deg, #86EFAC 0%, #34D399 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(34, 197, 94, 0.3);
}

.chip-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #064E3B;
  transition: color 0.3s ease;
}

.chip-selected .chip-text {
  color: #ffffff;
  font-weight: 600;
}

/* ============================================
   底部占位
   ============================================ */
.nature-spacer {
  height: 120rpx;
}

/* ============================================
   自然底部栏
   ============================================ */
.nature-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(34, 139, 34, 0.08);
  display: flex;
  gap: 12rpx;
  z-index: 100;
}

.nature-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.nature-btn::after {
  border: none;
}

.btn-ghost {
  background: #FAFAF9;
  color: #78716C;
  border: 2rpx solid #E7E5E4;
}

.btn-ghost:active {
  background: #F5F5F4;
}

.btn-nature {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(34, 197, 94, 0.3);
}

.btn-nature:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 8rpx rgba(34, 197, 94, 0.2);
}

.btn-loading {
  opacity: 0.7;
  pointer-events: none;
}

.nature-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}
