/* pages/pet-add/pet-add.wxss */
/* Soft UI Evolution - 现代柔和卡片风格 */

/* ============================================
   页面容器
   ============================================ */
.pet-add-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F0F4FF 0%, #F5F0FF 100%);
  display: flex;
  flex-direction: column;
}

/* ============================================
   柔和头部
   ============================================ */
.page-header {
  padding: 48rpx 32rpx 32rpx;
  text-align: center;
}

.header-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  opacity: 0.9;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.page-desc {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #6b7280;
  line-height: 1.3;
}

/* ============================================
   滚动内容
   ============================================ */
.form-scroll {
  flex: 1;
  height: 0;
  padding: 0 20rpx 24rpx;
}

/* ============================================
   软卡片
   ============================================ */
.soft-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 8rpx 32rpx rgba(99, 102, 241, 0.08),
    0 2rpx 8rpx rgba(99, 102, 241, 0.04),
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.card-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #6366f1;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  margin-bottom: 20rpx;
}

/* ============================================
   输入组
   ============================================ */
.input-group {
  margin-bottom: 20rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  line-height: 1.3;
  margin-bottom: 10rpx;
}

/* ============================================
   软输入框
   ============================================ */
.soft-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1f2937;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(229, 231, 235, 0.8);
  border-radius: 16rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
  box-shadow:
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.02),
    0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

.soft-input:focus {
  background: rgba(255, 255, 255, 1);
  border-color: #818cf8;
  box-shadow:
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.02),
    0 0 0 4rpx rgba(99, 102, 241, 0.1),
    0 4rpx 12rpx rgba(99, 102, 241, 0.1);
  outline: none;
}

.soft-input::placeholder {
  color: #9ca3af;
}

.input-disabled {
  background: rgba(249, 250, 251, 0.6);
  color: #9ca3af;
  border-color: rgba(243, 244, 246, 0.8);
}

/* ============================================
   软选择器
   ============================================ */
.soft-selector {
  height: 88rpx;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(229, 231, 235, 0.8);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  transition: all 0.3s ease;
  box-shadow:
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.02),
    0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

.soft-selector:active {
  background: rgba(255, 255, 255, 1);
  border-color: #818cf8;
  box-shadow:
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.02),
    0 0 0 4rpx rgba(99, 102, 241, 0.1);
}

.selector-value {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-value.placeholder {
  color: #9ca3af;
}

.chevron {
  font-size: 32rpx;
  color: #c7c9cc;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ============================================
   软标签页
   ============================================ */
.soft-tabs {
  display: flex;
  gap: 12rpx;
}

.soft-tab {
  flex: 1;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(229, 231, 235, 0.8);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-shadow:
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.02),
    0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

.soft-tab:active {
  transform: scale(0.98);
}

.tab-active {
  background: linear-gradient(135deg, #818cf8 0%, #a78bfa 100%);
  border-color: transparent;
  box-shadow:
    0 4rpx 12rpx rgba(99, 102, 241, 0.3),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.3);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #6b7280;
  transition: color 0.3s ease;
}

.tab-active .tab-text {
  color: #ffffff;
  font-weight: 600;
}

/* ============================================
   底部占位
   ============================================ */
.bottom-spacer {
  height: 120rpx;
}

/* ============================================
   底部栏
   ============================================ */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 20rpx 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 12rpx;
  z-index: 100;
}

.bar-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.bar-btn::after {
  border: none;
}

.btn-secondary {
  background: rgba(243, 244, 246, 0.8);
  color: #6b7280;
  border: 1rpx solid rgba(229, 231, 235, 0.8);
}

.btn-secondary:active {
  background: rgba(229, 231, 235, 0.8);
}

.btn-primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(99, 102, 241, 0.3);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 8rpx rgba(99, 102, 241, 0.2);
}

.btn-loading {
  opacity: 0.7;
  pointer-events: none;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}
