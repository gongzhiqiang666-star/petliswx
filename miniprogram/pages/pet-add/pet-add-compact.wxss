/* 宠物建档页面 - 一屏紧凑版样式 */

/* ============================================
   页面容器
   ============================================ */
.pet-add-page-compact {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

/* ============================================
   极简标题
   ============================================ */
.page-title-compact {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 16rpx;
}

.title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
}

.title-desc {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.2;
}

/* ============================================
   双列网格表单
   ============================================ */
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx 16rpx;
  flex: 1;
}

.form-column {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* ============================================
   表单字段 - 紧凑版
   ============================================ */
.form-field-compact {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.field-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #4b5563;
  line-height: 1.2;
}

.field-label::before {
  content: '*';
  color: #ef4444;
  font-size: 20rpx;
  margin-right: 2rpx;
}

.form-field-compact:not(:has(.field-readonly)) .field-label::before {
  content: '*';
}

.form-field-compact:has(.field-readonly) .field-label::before {
  content: '';
}

/* 输入框 */
.field-input-compact {
  height: 60rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  color: #1f2937;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.field-input-compact:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 2rpx rgba(102, 126, 234, 0.1);
}

.field-input-compact.has-value {
  border-color: #d1d5db;
}

.field-input-compact::placeholder {
  color: #9ca3af;
  font-size: 24rpx;
}

.field-readonly {
  background: #f9fafb;
  color: #6b7280;
}

/* 选择器 */
.field-selector-compact {
  height: 60rpx;
  padding: 0 12rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.field-selector-compact:active {
  background: #f9fafb;
}

.selector-text-compact {
  flex: 1;
  font-size: 26rpx;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-text-compact.placeholder {
  color: #9ca3af;
}

.selector-arrow {
  font-size: 20rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

/* 性别选择器 */
.gender-selector-compact {
  height: 60rpx;
  display: flex;
  gap: 8rpx;
}

.gender-option-compact {
  flex: 1;
  height: 100%;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.gender-option-compact.selected {
  background: #667eea;
  border-color: #667eea;
}

.gender-icon {
  font-size: 32rpx;
  line-height: 1;
  color: #667eea;
}

.gender-option-compact.selected .gender-icon {
  color: #ffffff;
}

/* 日期选择器 */
.field-picker-compact {
  height: 60rpx;
  padding: 0 12rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.picker-text-compact {
  flex: 1;
  font-size: 26rpx;
  color: #1f2937;
}

.picker-text-compact.placeholder {
  color: #9ca3af;
}

/* ============================================
   底部按钮
   ============================================ */
.bottom-actions-compact {
  display: flex;
  gap: 12rpx;
  padding-top: 12rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.action-btn-compact {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.action-btn-compact::after {
  border: none;
}

.btn-cancel {
  background: #ffffff;
  color: #6b7280;
  border: 1rpx solid #e5e7eb;
}

.btn-cancel:active {
  background: #f9fafb;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-primary.submitting {
  opacity: 0.7;
  pointer-events: none;
}

/* ============================================
   错误提示
   ============================================ */
.field-input-compact.error,
.field-selector-compact.error {
  border-color: #ef4444;
  background: #fef2f2;
}

.error-message {
  font-size: 20rpx;
  color: #ef4444;
  margin-top: 4rpx;
}

/* ============================================
   适配安全区域
   ============================================ */
@media (min-height: 700rpx) {
  .pet-add-page-compact {
    justify-content: space-between;
  }
}
