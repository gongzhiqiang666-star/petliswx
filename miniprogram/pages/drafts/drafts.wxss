@import "../../styles/petlis-3-overrides.wxss";
.page{padding:24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom))}.hint{color:#66817f;font-size:26rpx;line-height:1.7;margin:4rpx 0 28rpx}.card{background:#fff;border:1rpx solid #dce8e4;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx;font-size:30rpx;line-height:1.5}.meta{font-size:25rpx;color:#66817f;margin-top:12rpx}.row{display:flex;gap:16rpx;align-items:center;margin-top:24rpx}.row button{flex:1;width:auto;margin:0;min-height:84rpx;line-height:84rpx;font-size:28rpx;border-radius:14rpx;background:#f0f4f2;color:#486460}.row button::after{border:0}.row button[type=primary]{background:#1b8e89;color:#fff}.row button[disabled]{background:#e7ece9;color:#8a9c96}.error.petlis-empty{color:#C96F45;padding:24rpx 0;font-size:27rpx}.error .petlis-empty-text{color:#C96F45}.empty{text-align:center;padding:80rpx 24rpx;color:#66817f;font-size:28rpx}.empty-icon{display:block;width:112rpx;height:112rpx;margin:0 auto 24rpx}.row .delete-button{flex:0 0 144rpx;width:144rpx;min-height:88rpx;border-radius:44rpx;background:#FFFFFF;color:#FA5151;border:1rpx solid #FA5151;line-height:1.4}

.draft-section-title{font-size:32rpx;font-weight:600;color:#183d3b;margin:24rpx 0 18rpx}.legacy-section{border-top:1rpx solid #dce8e4;margin-top:40rpx;padding-top:12rpx}.legacy-error{font-size:26rpx;line-height:1.6;color:#9c4935;margin:20rpx 0}.legacy-open{margin-top:20rpx}.legacy-label{font-size:26rpx;color:#425c59;margin:24rpx 0 12rpx}.legacy-input{box-sizing:border-box;padding:18rpx;min-height:80rpx;font-size:28rpx}.legacy-choice-search{display:flex;gap:12rpx;margin-top:12rpx;align-items:center}.legacy-choice-search input{flex:1;min-width:0;padding:16rpx;font-size:24rpx}.legacy-choice-search button{flex:0 0 auto;margin:0;padding:0 20rpx;font-size:24rpx;min-height:72rpx;line-height:72rpx}.legacy-note text{white-space:pre-wrap;overflow-wrap:anywhere;font-size:26rpx;line-height:1.7;color:#425c59}

.legacy-projects-toggle{margin-top:28rpx}.legacy-projects{border-top:1rpx solid #dce8e4;margin-top:28rpx;padding-top:8rpx}.legacy-project-row{display:flex;gap:20rpx;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #edf2ef;font-size:28rpx}.legacy-project-row>view{flex:1;min-width:0;overflow-wrap:anywhere}.legacy-project-row button{flex:0 0 auto;margin:0;min-height:72rpx;line-height:72rpx;padding:0 20rpx;font-size:24rpx}
