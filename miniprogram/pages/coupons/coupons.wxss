@import "../../styles/native-theme.wxss";
page{background:#F5F7F6;color:#263d37}.page{padding:24rpx 32rpx}.title{font-size:42rpx;font-weight:600;margin-bottom:16rpx}.hint{color:#66766f;font-size:26rpx;line-height:1.6;margin:16rpx 0 32rpx}.card{background:white;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}input{padding:24rpx 0;border-bottom:1rpx solid #e8ece8}button{margin-top:24rpx;font-size:30rpx}button[type=primary]{background:#26745e}.card.petlis-list-card{border-radius:20rpx}.filters.petlis-filters{gap:0;margin-bottom:20rpx}.error.petlis-empty{color:#C96F45;margin:24rpx 0}.error .petlis-empty-text{color:#C96F45}button.petlis-btn-primary{background:var(--petlis-primary);color:#fff}button.petlis-btn-outline{background:#fff;color:var(--petlis-primary);border-color:var(--petlis-primary)}.row{display:flex;gap:16rpx;align-items:center;margin-top:20rpx}.tabs{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:24rpx}.tabs button{font-size:26rpx;margin:0}.meta{font-size:26rpx;color:#66766f;margin:10rpx 0}.empty{text-align:center;padding:60rpx 0;color:#66766f}textarea{background:#f8faf8;width:100%;box-sizing:border-box;padding:16rpx;margin-top:16rpx;border-radius:12rpx}.links{margin-top:40rpx;text-align:center}.balance{font-size:48rpx;font-weight:600;margin:16rpx 0}.line{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #edf0ec}.badge{color:#26745e;font-size:24rpx}.nav{padding:26rpx 0;border-bottom:1rpx solid #e8ece8}.filters{display:flex;gap:16rpx}.filters button{font-size:26rpx;margin:0}.amount{font-size:32rpx;font-weight:600}.empty-icon{display:block;width:96rpx;height:96rpx;margin:0 auto 20rpx}