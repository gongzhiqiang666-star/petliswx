<view class="page">
  <view class="filters petlis-filters"><button wx:for="{{filters}}" wx:key="id" data-id="{{item.id}}" class="petlis-filter-item {{category===item.id?'active':''}}" disabled="{{busy}}" bindtap="filter">{{item.title}}</button></view>
  <view wx:if="{{error}}" class="error petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">{{error}}</view><button class="petlis-btn petlis-btn-outline" bindtap="load">重试</button></view>
  <view wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="showDetail" class="card petlis-list-card"><view>{{item.name}}</view><view class="balance">¥{{item.amount}}</view><view class="meta">满 ¥{{item.minimumAmount}} 可用 · {{item.laboratoryName || '全部实验室'}}</view><view class="meta">有效期 {{item.starts}} 至 {{item.ends}}</view><view class="badge">{{item.label}}</view></view>
  <view wx:if="{{!busy && !items.length && !error}}" class="empty petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">当前分类暂无优惠券</view></view>
  <view class="coupon-sheet-mask" wx:if="{{detailVisible}}" catchtap="closeDetail">
    <view class="coupon-sheet" catchtap="showDetail">
      <view class="coupon-sheet-title">{{selectedCoupon.name}}</view>
      <view class="line"><text>优惠金额</text><text>¥{{selectedCoupon.amount}}</text></view>
      <view class="line"><text>使用门槛</text><text>满 ¥{{selectedCoupon.minimumAmount}} 可用</text></view>
      <view class="line"><text>适用实验室</text><text>{{selectedCoupon.laboratoryName || '全部实验室'}}</text></view>
      <view class="line"><text>有效期</text><text>{{selectedCoupon.starts}} 至 {{selectedCoupon.ends}}</text></view>
      <view class="line"><text>当前状态</text><text>{{selectedCoupon.label}}</text></view>
      <view class="hint" wx:if="{{selectedCoupon.status === 'reserved'}}">该券已为待审核或待支付订单预留，不会重复抵扣。</view>
      <button class="petlis-btn petlis-btn-primary" bindtap="closeDetail">知道了</button>
    </view>
  </view>
</view>
