<!--pages/sample-type-select/sample-type-select.wxml-->
<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <image src="/assets/icons/icon-search.png" class="search-icon" mode="aspectFit"></image>
    <input class="search-input"
           placeholder="搜索样本类型（中文或英文）"
           value="{{searchQuery}}"
           bindinput="onSearchInput" />
    <image src="/assets/icons/clear.png"
           class="clear-icon {{searchQuery ? 'show' : ''}}"
           mode="aspectFit"
           bindtap="onClearSearch"></image>
  </view>

  <!-- 分类标签 -->
  <view class="category-tabs">
    <view class="tab-item {{activeTab === index ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="filter"
          bindtap="onTabTap"
          data-index="{{index}}">
      {{item.name}}
    </view>
  </view>

  <!-- 样本类型列表 -->
  <scroll-view class="sample-list"
              scroll-y
              bindscrolltolower="onScrollToLower">
    <view class="sample-item"
          wx:for="{{filteredSamples}}"
          wx:key="infoSampleTypeId"
          bindtap="onSelectSample"
          data-sample="{{item}}">
      <view class="sample-info">
        <text class="sample-name-cn">{{item.sampleName}}</text>
        <text class="sample-name-en">{{item.sampleNameEn}}</text>
      </view>
      <image src="/assets/icons/arrow-down.png" class="arrow-icon" mode="aspectFit"></image>
    </view>

    <!-- 加载更多提示 -->
    <view class="loading-more" wx:if="{{isLoadingMore}}">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 没有更多提示 -->
    <view class="no-more" wx:if="{{!hasMore && filteredSamples.length > 0 && !searchQuery}}">
      <text class="no-more-text">没有更多了</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredSamples.length === 0}}">
      <image src="/assets/icons/empty-search.png" class="empty-icon" mode="aspectFit"></image>
      <text class="empty-text">未找到相关样本类型</text>
      <text class="empty-hint">请尝试其他关键词或切换分类</text>
    </view>
  </scroll-view>
</view>
