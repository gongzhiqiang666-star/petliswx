/* pages/sample-type-select/sample-type-select.wxss */

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx;
  height: 80rpx;
  background: white;
  border-radius: 48rpx;
  border: 2rpx solid #E2E8F0;
  padding: 0 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0;
  transition: opacity 0.3s;
}

.clear-icon.show {
  opacity: 1;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  background: white;
  margin: 0 24rpx;
  padding: 0 0 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.tab-item.active {
  color: white;
  background: #2563EB;
  font-weight: 500;
}

/* 样本类型列表 */
.sample-list {
  flex: 1;
  padding-bottom: 24rpx;
}

.sample-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  padding: 30rpx 24rpx;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  transition: background 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.sample-item:active {
  background: #f0f8ff;
}

.sample-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sample-name-cn {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.sample-name-en {
  font-size: 24rpx;
  color: #999;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 20rpx;
  opacity: 0.3;
}

/* 加载更多 */
.loading-more {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 28rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #999;
}
