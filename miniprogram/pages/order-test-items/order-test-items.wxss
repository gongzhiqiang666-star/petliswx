/* pages/order-test-items/order-test-items.wxss */
/* 微信原生简洁风格 */

/* Search Bar */
.search-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: white;
  border-radius: 8rpx;
  border: 1rpx solid #E5E5E5;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  margin: 16rpx 24rpx;
}

/* Search Hint */
.search-hint {
  padding: 16rpx 24rpx;
  background: #FFF9E6;
  border-radius: 8rpx;
  border: 1rpx solid #FFC300;
  margin: 0 24rpx 16rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #FA9D3B;
  line-height: 1.5;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #000000;
}

.search-input::placeholder {
  color: #CCCCCC;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0;
  transition: opacity 0.2s;
}

.clear-icon.show {
  opacity: 1;
}

/* Items List */
.items-list {
  height: calc(100vh - 160rpx);
  padding-bottom: 24rpx;
}

.item-card {
  display: flex;
  align-items: center;
  background: white;
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: background-color 0.2s;
  border: 1rpx solid #F0F0F0;
}

.item-card:active {
  background-color: #F7F7F7;
}

.item-card.selected {
  background: #F0F9FF;
  border-color: #2563EB;
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.1);
}

.item-checkbox {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 50%;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  flex-shrink: 0;
}

.item-checkbox.checked {
  background: #2563EB;
  border-color: #2563EB;
}

.checkbox-inner {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  color: #000000;
  font-weight: 500;
  margin-bottom: 8rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-price {
  font-size: 32rpx;
  color: #FA5151;
  font-weight: 600;
}

/* Loading & Empty States */
.loading-more {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #888888;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 28rpx;
  color: #CCCCCC;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 0;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #888888;
  line-height: 1.4;
}

/* Footer */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: white;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 96rpx;
}

.summary-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  padding: 8rpx 0;
}

.summary-count {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex-shrink: 0;
}

.count-number {
  font-size: 32rpx;
  color: #2563EB;
  font-weight: 600;
}

.count-unit {
  font-size: 24rpx;
  color: #888888;
}

.summary-divider {
  width: 1rpx;
  height: 32rpx;
  background: #E5E5E5;
  flex-shrink: 0;
}

.summary-price-wrapper {
  display: flex;
  align-items: baseline;
  min-width: 0;
  flex: 1;
}

.price-value {
  font-size: 32rpx;
  color: #FA5151;
  font-weight: 600;
}

.btn-next {
  padding: 16rpx 32rpx;
  background: #E5E5E5;
  color: #CCCCCC;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
  flex-shrink: 0;
}

.btn-next.active {
  background: #2563EB;
  color: white;
}

.btn-next:active {
  opacity: 0.8;
}

.btn-next::after {
  border: none;
}

/* Drawer Mask */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
  z-index: 100;
}

.drawer-mask.show {
  opacity: 1;
  visibility: visible;
}

/* Drawer */
.drawer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 16rpx 16rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 101;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.drawer.show {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.drawer-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.4;
}

.title-count {
  font-size: 26rpx;
  color: #888888;
}

.drawer-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #888888;
  background: #F7F7F7;
  border-radius: 50%;
}

.drawer-content {
  flex: 1;
  padding: 0 24rpx;
  overflow-y: auto;
}

.selected-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.selected-item:last-child {
  border-bottom: none;
}

.selected-item-info {
  flex: 1;
  min-width: 0;
}

.selected-item-name {
  font-size: 30rpx;
  color: #000000;
  font-weight: 500;
  margin-bottom: 8rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-item-price {
  font-size: 32rpx;
  color: #FA5151;
  font-weight: 600;
}

.selected-item-remove {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FEE2E2;
  border-radius: 50%;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.remove-icon {
  width: 24rpx;
  height: 24rpx;
}

.drawer-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 0;
}

.drawer-empty .empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.drawer-empty .empty-text {
  font-size: 28rpx;
  color: #888888;
}

.drawer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-top: 1rpx solid #F0F0F0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.drawer-total {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.total-label {
  font-size: 24rpx;
  color: #888888;
}

.total-price {
  font-size: 44rpx;
  color: #FA5151;
  font-weight: 600;
}

.drawer-btn-confirm {
  padding: 20rpx 48rpx;
  background: #2563EB;
  color: white;
  font-size: 30rpx;
  border-radius: 8rpx;
  border: none;
  font-weight: 500;
}

.drawer-btn-confirm:active {
  background: #06AD56;
}

.drawer-btn-confirm::after {
  border: none;
}
