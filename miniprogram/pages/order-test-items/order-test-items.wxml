<view class="page" role="main" aria-label="选择检测项目">
  <view class="page-header">
    <view class="flow-header">
      <view class="flow-steps" aria-label="送检进度：第 2 步，共 3 步">
        <view class="flow-step">
          <view class="flow-step-dot">1</view>
          <text class="flow-step-label">填写资料</text>
        </view>
        <view class="flow-connector"></view>
        <view class="flow-step active">
          <view class="flow-step-dot">2</view>
          <text class="flow-step-label">选择项目</text>
        </view>
        <view class="flow-connector"></view>
        <view class="flow-step">
          <view class="flow-step-dot">3</view>
          <text class="flow-step-label">确认送检</text>
        </view>
      </view>
    </view>

    <picker class="laboratory-picker" range="{{laboratories}}" range-key="name" bindchange="laboratoryChange">
      <view class="laboratory-card petlis-card">
        <view class="laboratory-copy">
          <text class="laboratory-label">检测实验室</text>
          <text class="laboratory-name {{laboratoryName ? '' : 'placeholder'}}">{{laboratoryName || '请选择实验室'}}</text>
        </view>
        <image class="picker-arrow" src="/assets/icons/brand-chevron-down.png" mode="aspectFit" aria-hidden="true"></image>
      </view>
    </picker>

    <view class="search-bar petlis-input" role="search">
      <image src="/assets/icons/brand-search.png" class="search-icon" mode="aspectFit" aria-hidden="true"></image>
      <input class="search-input"
             placeholder="输入检测项目名称或拼音"
             value="{{searchQuery}}"
             bindinput="onSearchInput"
             aria-label="搜索检测项目" />
      <image src="/assets/icons/brand-close.png"
             class="clear-icon {{searchQuery ? 'show' : ''}}"
             mode="aspectFit"
             bindtap="onClearSearch"
             role="button"
             aria-label="清空搜索"></image>
    </view>

    <view class="search-hint" role="status" wx:if="{{searchMode}}">
      <text class="hint-text">正在搜索检测项目，支持项目名称或拼音</text>
    </view>
  </view>

  <scroll-view class="items-list"
               scroll-y
               bindscrolltolower="onScrollToLower"
               role="list"
               aria-label="检测项目列表">
    <view class="petlis-empty load-error" wx:if="{{loadError}}" role="alert">
      <image src="/assets/icons/brand-empty.png" mode="aspectFit" aria-hidden="true"></image>
      <view class="petlis-empty-text">{{loadError}}</view>
      <button class="petlis-btn petlis-btn-outline petlis-empty-retry" bindtap="onRetryLoad">重新加载</button>
    </view>
    <view class="item-card petlis-list-card {{item.selected ? 'selected' : ''}}"
          wx:for="{{filteredItems}}"
          wx:key="infoTestTypeId"
          role="listitem"
          aria-label="{{item.testName}}，价格{{item.price>=0?'¥'+item.price:'价格待维护'}}，{{item.selected ? '已选择' : '未选择'}}"
          aria-selected="{{item.selected}}"
          bindtap="onToggleItem"
          data-id="{{item.infoTestTypeId}}">
      <view class="item-checkbox {{item.selected ? 'checked' : ''}}"
            role="checkbox"
            aria-checked="{{item.selected}}">
        <image class="checkbox-inner" src="/assets/icons/brand-check.png" mode="aspectFit" wx:if="{{item.selected}}" aria-hidden="true"></image>
      </view>
      <view class="item-main">
        <view class="item-name">{{item.testName}}</view>
        <view class="item-price">{{item.price>=0?'¥'+item.price:'价格待维护'}}</view>
      </view>
    </view>

    <view class="loading-more" wx:if="{{isLoadingMore}}" role="status" aria-label="正在加载更多">
      <text class="loading-text">加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && filteredItems.length > 0}}" role="status">
      <text class="no-more-text">已展示全部项目</text>
    </view>
    <view class="empty-state petlis-empty" wx:if="{{filteredItems.length === 0 && !loading && !loadError}}" role="status">
      <image src="/assets/icons/brand-empty.png" class="empty-icon" mode="aspectFit" aria-hidden="true"></image>
      <view class="empty-text">未找到相关检测项目</view>
      <view class="empty-hint">换个关键词试试，或检查实验室选择</view>
    </view>
  </scroll-view>

  <view class="footer" role="form" aria-label="已选择{{selectedCount}}个项目">
    <view class="summary-info"
          role="button"
          aria-label="查看已选项目，共{{selectedCount}}项，总价¥{{totalPrice}}"
          bindtap="onShowSelectedDrawer">
      <view class="summary-count">
        <text class="count-label">已选</text>
        <text class="count-number">{{selectedCount}}</text>
        <text class="count-unit">项</text>
      </view>
      <view class="summary-price-wrapper">
        <text class="price-label">合计</text>
        <text class="price-value">¥{{totalPrice}}</text>
      </view>
    </view>
    <button class="btn-next petlis-btn {{selectedCount > 0 ? 'active' : ''}}"
            bindtap="onNext"
            aria-label="{{selectedCount > 0 ? '下一步' : '请先选择检测项目'}}">
      {{selectedCount > 0 ? '下一步' : '请选择项目'}}
    </button>
  </view>

  <view class="drawer-mask petlis-modal-mask {{showDrawer ? 'show' : ''}}"
        role="presentation"
        bindtap="onHideDrawer"></view>
  <view class="drawer petlis-modal {{showDrawer ? 'show' : ''}}"
        role="dialog"
        aria-label="已选项目列表">
    <view class="drawer-header">
      <view class="drawer-title">
        <text class="title-text">已选项目</text>
        <text class="title-count">{{selectedCount}} 项</text>
      </view>
      <view class="drawer-close"
            role="button"
            aria-label="关闭已选项目列表"
            bindtap="onHideDrawer">
        <image class="drawer-close-icon" src="/assets/icons/brand-close.png" mode="aspectFit" aria-hidden="true"></image>
      </view>
    </view>

    <scroll-view class="drawer-content" scroll-y role="list">
      <view class="selected-item"
            role="listitem"
            wx:for="{{selectedItemsList}}"
            wx:key="infoTestTypeId">
        <view class="selected-item-info">
          <view class="selected-item-name">{{item.testName}}</view>
          <view class="selected-item-price">{{item.price>=0?'¥'+item.price:'价格待维护'}}</view>
        </view>
        <view class="selected-item-remove"
              role="button"
              aria-label="移除{{item.testName}}"
              catchtap="onRemoveItem"
              data-id="{{item.infoTestTypeId}}">
          <image src="/assets/icons/brand-close.png" class="remove-icon" mode="aspectFit" aria-hidden="true"></image>
        </view>
      </view>
      <view class="drawer-empty petlis-empty" wx:if="{{selectedItemsList.length === 0}}" role="status">
        <image src="/assets/icons/brand-empty.png" class="empty-icon" mode="aspectFit" aria-hidden="true"></image>
        <view class="empty-text">还没有选择任何项目</view>
      </view>
    </scroll-view>

    <view class="drawer-footer petlis-modal-actions">
      <view class="drawer-total">
        <text class="total-label">合计</text>
        <text class="total-price">¥{{totalPrice}}</text>
      </view>
      <button class="drawer-btn-confirm petlis-btn petlis-btn-primary"
              bindtap="onConfirmDrawer"
              aria-label="确定选择">确定</button>
    </view>
  </view>
</view>
