@import "../../styles/petlis-3-overrides.wxss";
/* pages/breed-select/breed-select.wxss */

/* 搜索栏 */
.search-bar {
  margin: 16rpx 24rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 48rpx;
  border: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
}

/* 品种列表 */
.list-container {
  position: relative;
  height: calc(100vh - 200rpx);
}

.breed-list {
  padding-bottom: 32rpx;
  height: 100%;
}

/* 分组标题 */
.group-header {
  padding: 24rpx 24rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6366f1;
  background: #f9fafb;
  position: sticky;
  top: 0;
  z-index: 10;
}

.breed-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin: 0 24rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.breed-item:active {
  background-color: #f3f4f6;
  transform: scale(0.98);
  opacity: 0.8;
}

.breed-info {
  flex: 1;
  min-width: 0; /* 允许文本截断 */
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.breed-name-cn {
  font-size: 32rpx;
  color: #111827;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.breed-name-en {
  font-size: 24rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.breed-check {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.check-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 字母索引栏 */
.index-bar {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 16rpx 8rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.index-item {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #6b7280;
  border-radius: 50%;
  transition: all 0.2s;
}

.index-item.active {
  background: #0D6E6E;
  color: #fff;
  font-weight: 600;
  transform: scale(1.2);
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}

/* 加载更多提示 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.load-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #9ca3af;
}
