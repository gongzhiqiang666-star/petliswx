<view class="page"><view class="filters petlis-filters"><button data-id="gifts" class="petlis-filter-item {{tab==='gifts'?'active':''}}" bindtap="tab" disabled="{{busy}}">兑换礼品</button><button data-id="history" class="petlis-filter-item {{tab==='history'?'active':''}}" bindtap="tab" disabled="{{busy}}">兑换记录</button></view><view wx:if="{{error}}" class="error petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">{{error}}</view><button class="petlis-btn petlis-btn-outline" bindtap="retry">刷新列表</button></view><view wx:if="{{gift}}" class="petlis-modal-mask"><view class="card petlis-modal"><view class="petlis-modal-title">{{gift.name}}</view><view class="petlis-modal-content"><view class="hint">{{gift.description}}</view><view>{{gift.pointsCost}} 积分/件 · 库存 {{gift.stock}}</view><view class="form-item"><view class="form-label">兑换数量</view><input class="petlis-input" data-field="quantity" value="{{quantity}}" type="number" bindinput="field" placeholder="请输入兑换数量"/></view><view class="modal-inline-actions"><button class="petlis-btn petlis-btn-outline" bindtap="chooseAddress">使用微信收货地址</button></view><view class="form-item"><view class="form-label">收件人</view><input class="petlis-input" data-field="recipient" value="{{recipient}}" bindinput="field" maxlength="50" placeholder="请输入收件人"/></view><view class="form-item"><view class="form-label">联系电话</view><input class="petlis-input" data-field="phone" value="{{phone}}" bindinput="field" maxlength="20" placeholder="请输入联系电话"/></view><view class="form-item"><view class="form-label">完整收货地址</view><textarea class="petlis-input" data-field="address" value="{{address}}" bindinput="field" maxlength="500" placeholder="请输入完整收货地址"/></view></view><view class="petlis-modal-actions"><button class="petlis-btn petlis-btn-outline" bindtap="cancel" disabled="{{busy}}">取消</button><button class="petlis-btn petlis-btn-primary" bindtap="redeem" loading="{{busy}}" disabled="{{busy}}">确认兑换 · {{gift.pointsCost*quantity}}积分</button></view></view></view><view wx:else><view wx:for="{{items}}" wx:key="id" class="card petlis-list-card"><view>{{item.name || item.giftName}}</view><view wx:if="{{tab==='gifts'}}"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFit" style="width:100%;height:240rpx"/><view class="hint">{{item.description}}</view><view>{{item.pointsCost}} 积分 · 剩余 {{item.stock}}件</view><view class="card-actions"><button class="petlis-btn petlis-btn-primary" data-id="{{item.id}}" bindtap="select" disabled="{{item.stock<1}}">{{item.stock>0?'查看并兑换':'已兑完'}}</button></view></view><view wx:else><view class="meta">数量 {{item.quantity}} · 消耗 {{item.pointsSpent}} 积分</view><view class="badge">{{item.status==='pending'?'待处理':item.status==='shipped'?'已发货':item.status==='completed'?'已完成':item.status}}</view><view wx:if="{{item.trackingNumber}}" class="meta">物流单号：{{item.trackingNumber}}</view></view></view><view wx:if="{{!busy && !items.length && !error}}" class="empty petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view>{{tab==='gifts'?'暂无可兑换礼品':'暂无兑换记录'}}</view></view><button wx:if="{{more}}" class="petlis-btn petlis-btn-outline" loading="{{busy}}" bindtap="more">加载更多</button></view></view>