/* pages/orders/orders.wxss */
/* 微信原生简洁风格 */

/* 页面容器 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F7F7F7;
}

/* Tabs */
.tabs {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E5E5;
  padding: 0 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #888888;
  position: relative;
  transition: color 0.2s;
  font-weight: 500;
  line-height: 1.4;
}

.tab-item.active {
  color: #2563EB;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #2563EB;
  border-radius: 2rpx;
}

/* Search Bar */
.search-bar {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E5E5;
}

/* Order List */
.order-list {
  flex: 1;
}

.order-card {
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F0F0F0;
  transition: box-shadow 0.2s;
}

.order-card:active {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* Status Badge */
.status-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.status-pending {
  background: #FFF7E6;
  color: #FF9D3B;
}

.status--3 {
  background: #F7F7F7;
  color: #888888;
}

.status--2 {
  background: #F7F7F7;
  color: #888888;
}

.status-0 {
  background: #F0F9FF;
  color: #2563EB;
}

.status-1 {
  background: #FEF0F0;
  color: #FA5151;
}

.status-2 {
  background: #FFF7E6;
  color: #FF9D3B;
}

.status-3 {
  background: #F0F9FF;
  color: #2563EB;
}

.status-4 {
  background: #F7F7F7;
  color: #CCCCCC;
}

/* Pet Info */
.pet-info {
  margin-bottom: 24rpx;
}

.pet-name {
  font-size: 32rpx;
  color: #000000;
  margin-bottom: 8rpx;
  font-weight: 600;
  line-height: 1.4;
}

.pet-breed {
  font-size: 28rpx;
  color: #888888;
  line-height: 1.4;
}

/* Order Details */
.order-details {
  margin-bottom: 24rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.detail-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

/* Order Footer */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.price {
  font-size: 36rpx;
  color: #2563EB;
  font-weight: 600;
  line-height: 1.4;
}

.actions {
  display: flex;
  gap: 12rpx;
}

/* Buttons - 重置微信小程序button默认样式 */
.btn-detail,
.btn-action {
  margin: 0;
  padding: 16rpx 24rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.4;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  white-space: nowrap;
  min-height: 72rpx;

  /* 重置宽度相关 */
  min-width: auto !important;
  width: auto !important;
  height: auto !important;
  min-height: auto !important;

  /* 重置flex布局 */
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 6rpx;

  /* 重置box-sizing */
  box-sizing: border-box;
}

.btn-detail::after,
.btn-action::after {
  border: none;
}

.btn-detail:active,
.btn-action:active {
  opacity: 0.8;
}

.btn-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  display: block;
  margin: 0;
  padding: 0;
}

.btn-action text,
.btn-detail text {
  display: inline-block;
  line-height: 1.4;
  margin: 0;
  padding: 0;
}

.btn-preview {
  background: #2563EB;
  color: #FFFFFF;
}

.btn-preview:active {
  opacity: 0.8;
}

.btn-download {
  background: #2563EB;
  color: #FFFFFF;
}

.btn-download:active {
  opacity: 0.8;
}

.btn-pay {
  background: #FA5151;
  color: #FFFFFF;
}

.btn-pay:active {
  opacity: 0.8;
}

/* Loading More */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #F0F0F0;
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.4;
}

/* No More */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #CCCCCC;
  line-height: 1.4;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 24rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: #F7F7F7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon .icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #888888;
  margin-bottom: 48rpx;
  line-height: 1.4;
}

.btn-primary {
  padding: 20rpx 64rpx;
  background: #2563EB;
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 8rpx;
  border: none;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  line-height: 1.4;
  min-height: 88rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.8;
}
