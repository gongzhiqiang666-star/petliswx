<!--pages/orders/orders.wxml-->
<view class="page" role="main" aria-label="订单列表">
  <!-- Tabs -->
  <view class="tabs" role="tablist" aria-label="订单筛选">
    <view class="tab-item {{activeTab === item.id ? 'active' : ''}}"
          role="tab"
          aria-selected="{{activeTab === item.id}}"
          aria-label="{{item.label}}"
          wx:for="{{tabs}}"
          wx:key="id"
          bindtap="onTabChange"
          data-id="{{item.id}}">
      {{item.label}}
    </view>
  </view>

  <!-- Search Bar -->
  <view class="search-bar" role="search" aria-label="搜索订单">
    <search-input
      placeholder="搜索订单号/宠物名/畜主名"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <!-- Order List -->
  <scroll-view class="order-list"
              scroll-y
              bindscrolltolower="onReachBottom"
              role="list"
              aria-label="订单列表">
    <view class="order-card"
          role="listitem"
          aria-label="{{item.animalName}}的订单，状态{{item.statusLabel}}，金额¥{{item.totalPrice || item.testFee || '0.00'}}"
          wx:for="{{filteredOrders}}"
          wx:key="orderId"
          bindtap="onViewDetail"
          data-id="{{item.orderId}}">
      <!-- Status Badge -->
      <view class="status-badge status-{{item.sampleStatus}}">
        {{item.statusLabel}}
      </view>

      <!-- Pet Info -->
      <view class="pet-info">
        <view class="pet-name">{{item.animalName}}</view>
        <view class="pet-breed">{{item.animalType}}</view>
      </view>

      <!-- Order Details -->
      <view class="order-details">
        <view class="detail-item">
          <image src="/assets/icons/icon-monthly.png" class="detail-icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true"></image>
          <text>采样日期：{{item.collectDt}}</text>
        </view>
        <view class="detail-item">
          <image src="/assets/icons/icon-time.png" class="detail-icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true"></image>
          <text>创建时间：{{item.createDtText}}</text>
        </view>
      </view>

      <!-- Price and Actions -->
      <view class="order-footer">
        <view class="price" aria-label="订单金额¥{{item.totalPrice || item.testFee || '0.00'}}">¥{{item.totalPrice || item.testFee || '0.00'}}</view>
        <view class="actions">
          <!-- 草稿订单（-3待支付、-2草稿）显示去支付按钮 -->
          <button class="btn-action btn-pay"
                  role="button"
                  aria-label="支付订单，金额¥{{item.totalPrice || item.testFee || '0.00'}}"
                  catchtap="onPayOrder"
                  data-id="{{item.orderId}}"
                  data-amount="{{item.totalPrice || item.testFee}}"
                  wx:if="{{item.sampleStatus == -3}}">
            <image src="/assets/icons/icon-pay.png" class="btn-icon" mode="aspectFit" aria-hidden="true"></image>
            <text>去支付</text>
          </button>
          <!-- 已完成订单显示报告按钮 -->
          <block wx:elif="{{item.sampleStatus == 3}}">
            <button class="btn-action btn-preview"
                    role="button"
                    aria-label="预览检测报告"
                    catchtap="onPreviewReport"
                    data-id="{{item.orderId}}">
              <image src="/assets/icons/icon-file.png" class="btn-icon" mode="aspectFit" aria-hidden="true"></image>
              <text>预览</text>
            </button>
            <button class="btn-action btn-download"
                    role="button"
                    aria-label="下载检测报告"
                    catchtap="onDownloadReport"
                    data-id="{{item.orderId}}">
              <image src="/assets/icons/download.png" class="btn-icon" mode="aspectFit" aria-hidden="true"></image>
              <text>下载</text>
            </button>
          </block>
          <!-- 其他状态显示查看详情 -->
          <button class="btn-detail"
                  role="button"
                  aria-label="查看订单详情"
                  catchtap="onViewDetail"
                  data-id="{{item.orderId}}"
                  wx:else>查看详情</button>
        </view>
      </view>
    </view>

    <!-- Empty State -->
    <view class="empty-state"
          role="region"
          aria-label="暂无订单"
          wx:if="{{filteredOrders.length === 0 && !loading}}">
      <view class="empty-icon">
        <image src="/assets/icons/info-icon.png" class="icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true"></image>
      </view>
      <view class="empty-text">暂无订单</view>
      <button class="btn-primary"
              role="button"
              aria-label="创建新预约"
              bindtap="onNewOrder">去预约</button>
    </view>

    <!-- Loading More Indicator -->
    <view class="loading-more"
          role="status"
          aria-live="polite"
          aria-label="正在加载更多订单"
          wx:if="{{isLoadingMore}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- No More Indicator -->
    <view class="no-more"
          role="status"
          aria-label="已加载全部订单"
          wx:if="{{!hasMore && filteredOrders.length > 0 && !isLoadingMore}}">
      <text class="no-more-text">没有更多了</text>
    </view>
  </scroll-view>
</view>
