<view class="page" role="main" aria-label="订单列表">
  <view class="filter-panel petlis-card filter-card">
    <view class="filter-main-row">
      <scroll-view class="tabs-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="tabs petlis-filters" role="tablist" aria-label="订单筛选">
          <view class="tab-item petlis-filter-item {{activeTab === item.id ? 'active' : ''}}"
                role="tab"
                aria-selected="{{activeTab === item.id}}"
                aria-label="{{item.label}}"
                wx:for="{{tabs}}"
                wx:key="id"
                bindtap="onTabChange"
                data-id="{{item.id}}">{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="search-bar petlis-input" role="search" aria-label="搜索订单">
        <search-input
          placeholder="搜索订单"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
        />
      </view>
      <view class="filter-toggle" role="button" aria-label="展开或收起日期筛选" aria-expanded="{{showFilters}}" bindtap="toggleFilters">
        <image src="/assets/icons/brand-calendar.png" mode="aspectFit" aria-hidden="true"></image>
        <text>筛选</text>
      </view>
    </view>
    <view class="date-filter" wx:if="{{showFilters}}">
      <picker class="date-picker" mode="date" value="{{startDate}}" data-key="startDate" bindchange="dateChange">
        <view class="date-value petlis-input {{startDate ? '' : 'placeholder'}}">
          <image class="date-calendar" src="/assets/icons/brand-calendar.png" mode="aspectFit" aria-hidden="true"></image>
          <text>{{startDate || '开始日期'}}</text>
          <image class="date-chevron" src="/assets/icons/brand-chevron-down.png" mode="aspectFit" aria-hidden="true"></image>
        </view>
      </picker>
      <text class="date-separator">至</text>
      <picker class="date-picker" mode="date" value="{{endDate}}" data-key="endDate" bindchange="dateChange">
        <view class="date-value petlis-input {{endDate ? '' : 'placeholder'}}">
          <image class="date-calendar" src="/assets/icons/brand-calendar.png" mode="aspectFit" aria-hidden="true"></image>
          <text>{{endDate || '结束日期'}}</text>
          <image class="date-chevron" src="/assets/icons/brand-chevron-down.png" mode="aspectFit" aria-hidden="true"></image>
        </view>
      </picker>
      <text class="clear-dates" bindtap="clearDates">清除</text>
    </view>
  </view>

  <view class="error-state petlis-empty" wx:if="{{errorMessage}}">
    <image src="/assets/icons/brand-empty.png" mode="aspectFit" />
    <view class="petlis-empty-text">{{errorMessage}}</view>
    <button class="petlis-btn petlis-btn-outline" bindtap="resetAndLoadOrders">重新加载</button>
  </view>

  <scroll-view class="order-list"
               scroll-y
               bindscrolltolower="onReachBottom"
               role="list"
               aria-label="订单列表">
    <view class="order-card petlis-list-card"
          role="listitem"
          aria-label="{{item.animalName}}的订单，状态{{item.statusLabel}}，金额¥{{item.totalPrice || item.testFee || '0.00'}}"
          wx:for="{{filteredOrders}}"
          wx:key="orderId"
          bindtap="onViewDetail"
          data-id="{{item.orderId}}">
      <view class="order-card-head">
        <view class="pet-info">
          <view class="pet-name">{{item.animalName}}</view>
          <view class="pet-breed">{{item.animalType}}</view>
        </view>
        <view class="status-badge status-{{item.sampleStatus}}">{{item.statusLabel}}</view>
      </view>

      <view class="order-details">
        <view class="detail-item">
          <view class="detail-dot"></view>
          <text class="detail-label">采样</text>
          <text class="detail-value">{{item.collectDt}}</text>
        </view>
        <view class="detail-item">
          <view class="detail-dot"></view>
          <text class="detail-label">创建</text>
          <text class="detail-value">{{item.createDtText}}</text>
        </view>
      </view>

      <view class="logistics-brief" wx:if="{{item.logistics}}">
        <text>{{item.logistics.latestTimeline || item.logistics.statusLabel}}</text>
        <text wx:if="{{item.logistics.expectedArrivedAt}}">预计 {{item.logistics.expectedArrivedAt}} 到达</text>
        <text class="logistics-brief-error" wx:if="{{item.logistics.exceptionNote}}">异常：{{item.logistics.exceptionNote}}</text>
      </view>

      <view class="order-footer">
        <view class="price-wrap">
          <text class="price-label">订单金额</text>
          <view class="price" aria-label="订单金额¥{{item.totalPrice || item.testFee || '0.00'}}">¥{{item.totalPrice || item.testFee || '0.00'}}</view>
        </view>
        <view class="actions">
          <button class="petlis-btn petlis-btn-primary btn-action btn-pay"
                  role="button"
                  aria-label="支付订单，金额¥{{item.totalPrice || item.testFee || '0.00'}}"
                  catchtap="onPayOrder"
                  data-id="{{item.orderId}}"
                  data-amount="{{item.totalPrice || item.testFee}}"
                  wx:if="{{item.sampleStatus == -3}}">
            <image src="/assets/icons/brand-wallet.png" class="btn-icon" mode="aspectFit" aria-hidden="true"></image>
            <text>去支付</text>
          </button>
          <block wx:elif="{{item.sampleStatus == 3}}">
            <button class="petlis-btn petlis-btn-primary btn-action btn-preview"
                    role="button"
                    aria-label="预览检测报告"
                    catchtap="onPreviewReport"
                    data-id="{{item.orderId}}">
              <image src="/assets/icons/brand-file.png" class="btn-icon" mode="aspectFit" aria-hidden="true"></image>
              <text>预览</text>
            </button>
            <button class="petlis-btn petlis-btn-primary btn-action btn-download"
                    role="button"
                    aria-label="下载检测报告"
                    catchtap="onDownloadReport"
                    data-id="{{item.orderId}}">
              <image src="/assets/icons/brand-download.png" class="btn-icon" mode="aspectFit" aria-hidden="true"></image>
              <text>下载</text>
            </button>
          </block>
          <button class="btn-detail petlis-btn petlis-btn-outline"
                  role="button"
                  aria-label="查看订单详情"
                  catchtap="onViewDetail"
                  data-id="{{item.orderId}}"
                  wx:else>查看详情</button>
        </view>
      </view>
    </view>

    <view class="empty-state petlis-empty"
          role="region"
          aria-label="暂无订单"
          wx:if="{{filteredOrders.length === 0 && !loading}}">
      <view class="empty-icon">
        <image src="/assets/icons/brand-empty.png" class="icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true"></image>
      </view>
      <view class="empty-text">暂无符合条件的送检记录</view>
      <view class="empty-hint">调整筛选条件，或发起一次新送检</view>
      <button class="btn-primary petlis-btn petlis-btn-primary"
              role="button"
              aria-label="创建新预约"
              bindtap="onNewOrder">去预约</button>
    </view>

    <view class="loading-more"
          role="status"
          aria-live="polite"
          aria-label="正在加载更多订单"
          wx:if="{{isLoadingMore}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>
    <view class="no-more"
          role="status"
          aria-label="已加载全部订单"
          wx:if="{{!hasMore && filteredOrders.length > 0 && !isLoadingMore}}">
      <text class="no-more-text">已展示全部订单</text>
    </view>
  </scroll-view>
</view>
