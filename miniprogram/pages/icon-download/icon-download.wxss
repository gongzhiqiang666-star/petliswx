/* pages/icon-download/icon-download.wxss */

/* Header */
.header {
  background: #fff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #e5e7eb;
}

.back-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.header-title {
  font-size: 36rpx;
  color: #111827;
  font-weight: 600;
}

.placeholder {
  width: 48rpx;
}

/* Stats Card */
.stats-card {
  margin: 32rpx;
  padding: 40rpx;
  border-radius: 32rpx;
}

.gradient-bg {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.stats-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stats-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.stats-number {
  font-size: 56rpx;
  color: #fff;
  font-weight: 600;
}

.sparkle-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.8;
}

.stats-grid {
  display: flex;
  gap: 24rpx;
}

.stat-box {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
}

.stat-box-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 8rpx;
}

.stat-box-value {
  font-size: 36rpx;
  color: #fff;
}

/* Quick Download */
.quick-download {
  margin: 0 24rpx 32rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.2);
}

.quick-download-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.quick-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-icon {
  width: 40rpx;
  height: 40rpx;
}

.quick-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.quick-title {
  font-size: 32rpx;
  color: #fff;
}

.quick-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.quick-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.8;
}

/* Search Section */
.search-section {
  margin: 16rpx 24rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 48rpx;
  border: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0;
  transition: opacity 0.3s;
}

.clear-icon.show {
  opacity: 1;
}

/* Category Scroll */
.category-scroll {
  padding-bottom: 32rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  background: #fff;
  color: #374151;
  border: 2rpx solid #e5e7eb;
  white-space: nowrap;
  transition: all 0.3s;
}

.category-item.active {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #fff;
  border-color: transparent;
}

/* Select All Button */
.select-all-btn {
  margin: 0 24rpx 24rpx;
  height: 72rpx;
  background: #fff;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #374151;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
}

/* Icons Grid */
.icons-grid {
  padding-bottom: 32rpx;
  height: calc(100vh - 680rpx);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.icon-card {
  background: #fff;
  border-radius: 16rpx;
  border: 4rpx solid #E2E8F0;
  padding: 32rpx;
  position: relative;
  transition: all 0.3s;
}

.icon-card.selected {
  border-color: #2563EB;
  background: #eef2ff;
}

.icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: #f3f4f6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  transition: all 0.3s;
}

.icon-wrapper.selected {
  background: #DBEAFE;
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}

.icon-name {
  font-size: 24rpx;
  color: #111827;
  text-align: center;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.icon-category {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  display: block;
}

.check-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 32rpx;
  height: 32rpx;
  opacity: 0;
  transition: opacity 0.3s;
}

.check-badge.show {
  opacity: 1;
}

/* Empty State */
.empty-state {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 0;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 32rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #9ca3af;
}

/* Bottom Actions */





.btn-icon {
  width: 32rpx;
  height: 32rpx;
}

.btn-primary[disabled] {
  opacity: 0.5;
}
