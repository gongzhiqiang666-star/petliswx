@import "../../styles/native-theme.wxss";

page {
  background: #F5F7F6;
}

.page {
  height: 100vh;
  overflow: hidden;
  background: #F5F7F6;
}

.content {
  height: 100%;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.content.with-actions {
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}

.report-header {
  position: relative;
  display: flex;
  overflow: hidden;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 38rpx 36rpx;
  border: 0;
  border-radius: 32rpx;
  background: #0B3D3A;
  box-shadow: 0 16rpx 36rpx rgba(11, 61, 58, .12);
}

.report-header::after {
  content: '';
  position: absolute;
  top: -96rpx;
  right: -56rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .05);
}

.report-heading {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.pet-name {
  overflow-wrap: anywhere;
  color: #F1F7F4;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: .5rpx;
}

.report-type {
  overflow-wrap: anywhere;
  color: #B9D4CD;
  font-size: 26rpx;
  font-weight: 300;
  line-height: 1.6;
}

.payment-badge,
.report-status {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 9rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.5;
}

.payment-badge {
  background: #F7EAE2;
  color: #C96F45;
}

.report-status {
  border: 1rpx solid rgba(255, 255, 255, .2);
  background: rgba(255, 255, 255, .06);
  color: #C9E2DA;
}

.report-status.processing {
  background: rgba(255, 255, 255, .1);
  color: #EAF3F0;
}

.payment-lock {
  margin-bottom: 24rpx;
  box-sizing: border-box;
  padding: 34rpx 32rpx;
  border: 1rpx solid #EFD8CA;
  border-radius: 32rpx;
  background: #FBF3ED;
}

.payment-lock-copy {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.payment-lock-icon {
  width: 36rpx;
  height: 36rpx;
  margin-top: 5rpx;
  flex-shrink: 0;
  opacity: .8;
}

.payment-lock-text {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.payment-lock-title {
  color: #C96F45;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.5;
}

.payment-lock-desc {
  overflow-wrap: anywhere;
  color: #7E746D;
  font-size: 25rpx;
  font-weight: 300;
  line-height: 1.7;
}

.payment-lock-button {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background: #0D6E6E;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.payment-lock-button::after,
.bottom-actions button::after {
  border: 0;
}

.payment-lock-button:active,
.bottom-actions .btn-primary:active {
  background: #0B3D3A;
}

.info-card,
.pdf-card {
  margin-bottom: 24rpx;
  padding: 36rpx;
  border: 1rpx solid #E3EAE7;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(11, 61, 58, .05);
}

.card-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: .5rpx;
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 6rpx;
  background: #0D6E6E;
}

.info-row {
  display: flex;
  min-height: 78rpx;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx;
  border-bottom: 1rpx solid #EBF0ED;
  font-size: 25rpx;
  line-height: 1.6;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex-shrink: 0;
  color: #98A8A3;
  font-weight: 300;
}

.info-value {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
  color: #33443F;
  font-weight: 400;
  text-align: right;
}

.info-mono {
  font-family: monospace;
  font-size: 24rpx;
}

.payment-status {
  font-weight: 500;
}

.payment-status.unpaid {
  color: #C96F45;
}

.payment-status.paid {
  color: #0D6E6E;
}

.report-summary {
  margin-bottom: 26rpx;
  padding: 0 4rpx;
}

.summary-text {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow-wrap: anywhere;
  color: #667872;
  font-size: 26rpx;
  font-weight: 300;
  line-height: 1.8;
}

.pdf-locked,
.pdf-file {
  display: flex;
  min-height: 144rpx;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  padding: 28rpx 24rpx;
  border: 1rpx solid #E7EEEA;
  border-radius: 28rpx;
  background: #F5F7F6;
}

.pdf-locked {
  border-color: #E3EAE7;
  background: #F5F7F6;
}

.pdf-icon {
  border-radius: 24rpx;
  background: #E6F0EC;
}

.pdf-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.pdf-title,
.pdf-filename {
  overflow-wrap: anywhere;
  color: #263832;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.55;
}

.pdf-desc {
  overflow-wrap: anywhere;
  color: #85968F;
  font-size: 23rpx;
  font-weight: 300;
  line-height: 1.65;
}

.bottom-actions {
  min-height: 136rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E3EAE7;
  box-shadow: 0 -8rpx 24rpx rgba(11, 61, 58, .05);
}

.bottom-actions button {
  display: flex;
  min-width: 0;
  min-height: 88rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.bottom-actions .btn-outline {
  border: 1rpx solid #D7E4DF;
  background: #FFFFFF;
  color: #0D6E6E;
}

.bottom-actions .btn-outline:active {
  background: #E6F0EC;
}

.bottom-actions .btn-primary {
  background: #0D6E6E;
  box-shadow: 0 8rpx 20rpx rgba(13, 110, 110, .12);
}

.btn-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}
