@import "../../styles/petlis-3-overrides.wxss";

page {
  background: #F5F7F6;
}

.page {
  display: flex;
  height: 100vh;
  flex-direction: column;
  background: #F5F7F6;
  color: #263832;
}

.pets-header {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  margin: 24rpx 32rpx;
  padding: 36rpx;
  border-radius: 32rpx;
  background: #0B3D3A;
  box-shadow: 0 16rpx 36rpx rgba(11, 61, 58, .12);
}

.pets-header::after {
  content: '';
  position: absolute;
  top: -88rpx;
  right: -48rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .05);
}

.pets-title {
  position: relative;
  color: #F1F7F4;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

.pets-subtitle {
  position: relative;
  margin-top: 10rpx;
  color: #B9D4CD;
  font-size: 24rpx;
  font-weight: 300;
  line-height: 1.6;
}

.search-bar {
  display: flex;
  height: 96rpx;
  flex-shrink: 0;
  align-items: center;
  box-sizing: border-box;
  margin: 24rpx 32rpx;
  padding: 0 20rpx 0 28rpx;
  border: 1rpx solid #E3EAE7;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(11, 61, 58, .04);
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 18rpx;
  opacity: .48;
}

.search-input {
  min-width: 0;
  height: 94rpx;
  flex: 1;
  color: #263832;
  font-size: 27rpx;
  line-height: 94rpx;
}

.search-placeholder {
  color: #A3B2AC;
  font-weight: 300;
}

.clear-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-left: 8rpx;
  padding: 29rpx;
  opacity: 0;
  transition: opacity .2s;
}

.clear-icon.show {
  opacity: .5;
}

.pet-list {
  min-height: 0;
  flex: 1;
  box-sizing: border-box;
  padding: 8rpx 0 calc(156rpx + env(safe-area-inset-bottom));
}

.pet-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  border: 1rpx solid #E3EAE7;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(11, 61, 58, .05);
  transition: box-shadow .2s;
}

.pet-card:active {
  box-shadow: 0 16rpx 36rpx rgba(11, 61, 58, .09);
}

.pet-main {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  gap: 24rpx;
}

.pet-avatar {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E3EAE7;
  border-radius: 28rpx;
  background: #E6F0EC;
}

.pet-avatar image {
  width: 100%;
  height: 100%;
}

.pet-info {
  min-width: 0;
  flex: 1;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.pet-name {
  min-width: 0;
  overflow-wrap: anywhere;
  color: #0B3D3A;
  font-size: 33rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: .5rpx;
}

.gender-badge {
  display: flex;
  min-width: 42rpx;
  height: 36rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 10rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
  line-height: 1;
}

.gender-badge.male {
  background: #E6F0EC;
  color: #0D6E6E;
}

.gender-badge.female {
  background: #F7EAE2;
  color: #C96F45;
}

.pet-details {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail-item {
  overflow-wrap: anywhere;
  color: #8A9B95;
  font-size: 23rpx;
  font-weight: 300;
  line-height: 1.5;
}

.pet-details .pet-breed {
  color: #667872;
  font-size: 25rpx;
}

.edit-btn {
  display: flex;
  width: 88rpx;
  min-height: 88rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-right: -16rpx;
  color: #0D6E6E;
  font-size: 25rpx;
  line-height: 1.4;
}

.edit-btn:active {
  opacity: .55;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 32rpx;
  padding: 72rpx 32rpx;
  border: 1rpx solid #E3EAE7;
  border-radius: 32rpx;
  background: #FFFFFF;
}

.empty-icon {
  display: flex;
  width: 144rpx;
  height: 144rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  border-radius: 50%;
  background: #F5F7F6;
}

.empty-icon .icon {
  width: 120rpx;
  height: 120rpx;
  opacity: .45;
}

.empty-text {
  margin-bottom: 10rpx;
  color: #33443F;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.5;
}

.empty-hint {
  margin-bottom: 36rpx;
  color: #98A8A3;
  font-size: 24rpx;
  font-weight: 300;
  line-height: 1.6;
  text-align: center;
}

.empty-state .btn-primary {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  border: 0;
  border-radius: 24rpx;
  background: #0D6E6E;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.empty-state .btn-primary::after {
  border: 0;
}

.bottom-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E3EAE7;
  background: #FFFFFF;
  box-shadow: 0 -8rpx 24rpx rgba(11, 61, 58, .05);
}

.add-pet-btn {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #0D6E6E;
  box-shadow: 0 8rpx 20rpx rgba(13, 110, 110, .12);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.add-pet-btn:active {
  background: #0B3D3A;
}

.plus-icon {
  width: 30rpx;
  height: 30rpx;
}

.loading-more,
.no-more {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  color: #98A8A3;
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
  border: 2rpx solid #E3EAE7;
  border-top-color: #0D6E6E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.no-more-text {
  font-size: 23rpx;
  font-weight: 300;
  line-height: 1.5;
}
