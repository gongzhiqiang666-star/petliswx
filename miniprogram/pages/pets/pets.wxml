<view class="page" role="main" aria-label="宠物列表">
  <view class="search-bar" role="search" aria-label="搜索宠物">
    <image src="/assets/icons/brand-search.png" class="search-icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true" />
    <input class="search-input petlis-input" aria-label="搜索宠物姓名或主人姓名" placeholder="搜索宠物姓名、主人姓名" placeholder-class="search-placeholder" value="{{searchQuery}}" bindinput="onSearchInput" />
    <image src="/assets/icons/brand-close.png" class="clear-icon {{searchQuery ? 'show' : ''}}" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true" bindtap="onClearSearch" />
  </view>

  <view class="petlis-empty" wx:if="{{loadError}}" role="alert">
    <image src="/assets/icons/brand-empty.png" mode="aspectFit" aria-hidden="true" />
    <view class="petlis-empty-text">{{loadError}}</view>
    <button class="petlis-btn petlis-btn-outline petlis-empty-retry" bindtap="onRetryLoad">重新加载</button>
  </view>
  <scroll-view class="pet-list" scroll-y bindscrolltolower="onReachBottom" role="list" aria-label="宠物列表">
    <view class="pet-card petlis-list-card" role="listitem" aria-label="{{item.animalName}}，{{item.breed}}，{{item.age}}岁，主人{{item.ownerName}}" wx:for="{{filteredPets}}" wx:key="id" bindtap="onViewDetail" data-id="{{item.id}}">
      <view class="pet-main">
        <view class="pet-avatar">
          <image src="/assets/icons/brand-archive.png" mode="aspectFill" lazy-load="{{true}}" aria-hidden="true" />
        </view>
        <view class="pet-info">
          <view class="pet-name-row">
            <text class="pet-name">{{item.animalName}}</text>
            <view class="gender-badge {{item.dictSexId === 1 ? 'male' : 'female'}}">{{item.dictSexId === 1 ? '公' : '母'}}</view>
          </view>
          <view class="pet-details">
            <view class="detail-item pet-breed">{{item.breed}}</view>
            <view class="detail-item">年龄：{{item.age}}</view>
            <view class="detail-item">畜主：{{item.ownerName}}</view>
          </view>
        </view>
        <view class="edit-btn" role="button" aria-label="编辑{{item.animalName}}的信息" catchtap="onEditPet" data-id="{{item.id}}">
          <text>编辑</text>
        </view>
      </view>
    </view>

    <view class="empty-state petlis-empty" role="region" aria-label="暂无宠物" wx:if="{{filteredPets.length === 0 && !loading}}">
      <view class="empty-icon">
        <image src="/assets/icons/brand-empty.png" class="icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true" />
      </view>
      <view class="empty-text">还没有添加宠物</view>
      <view class="empty-hint">点击下方按钮添加您的第一只宠物</view>
      <button class="btn-primary petlis-btn petlis-btn-primary" role="button" aria-label="添加新宠物" bindtap="onAddPet">添加宠物</button>
    </view>

    <view class="loading-more" role="status" aria-live="polite" aria-label="正在加载更多宠物" wx:if="{{isLoadingMore}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view class="no-more" role="status" aria-label="已加载全部宠物" wx:if="{{!hasMore && filteredPets.length > 0 && !isLoadingMore}}">
      <text class="no-more-text">没有更多了</text>
    </view>
  </scroll-view>

  <view class="bottom-action">
    <view class="add-pet-btn petlis-btn petlis-btn-primary" role="button" aria-label="添加新宠物" bindtap="onAddPet">
      <image src="/assets/icons/brand-plus.png" class="plus-icon" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true" />
      <text>添加新宠物</text>
    </view>
  </view>
</view>
