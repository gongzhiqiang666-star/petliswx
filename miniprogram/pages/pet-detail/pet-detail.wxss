/* pages/pet-detail/pet-detail.wxss */
/* 微信原生简洁风格 */

/* Page Container */
.page {
  width: 100%;
  min-height: 100vh;
  background-color: #F7F7F7;
  display: flex;
  flex-direction: column;
}

/* Header */
.header {
  padding: 96rpx 24rpx 64rpx;
  position: relative;
}

.gradient-bg {
  background: #2563EB;
}

.back-btn,
.edit-btn {
  position: absolute;
  top: 40rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  left: 24rpx;
}

.edit-btn {
  right: 24rpx;
}

.back-icon,
.edit-icon {
  width: 32rpx;
  height: 32rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-name {
  font-size: 48rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.pet-name-en {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* Stats Bar */
.stats-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E5E5;
  display: flex;
  padding: 0 32rpx;
}

.stat-item {
  flex: 1;
  padding: 32rpx 0;
  text-align: center;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 48rpx;
  width: 1rpx;
  background: #E5E5E5;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.stat-value {
  font-size: 28rpx;
  color: #000000;
  line-height: 1.4;
}

/* Content */
.content {
  flex: 1;
  padding-bottom: 120rpx; /* 为底部按钮留出空间 */
}

/* Card */
.card {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F0F0F0;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.header-line {
  width: 6rpx;
  height: 28rpx;
  background: #2563EB;
  border-radius: 3rpx;
}

.card-title {
  font-size: 32rpx;
  color: #000000;
  font-weight: 600;
  line-height: 1.4;
}

/* Info Section - 信息分组 */
.info-section {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.info-section:last-child {
  border-bottom: none;
}

/* Info Row - 横向布局 */
.info-row {
  display: flex;
  gap: 16rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-item.half {
  flex: 1;
}

.info-item.full {
  flex: 1;
}

/* Info Label & Value */
.info-label {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.info-value {
  font-size: 28rpx;
  color: #000000;
  line-height: 1.4;
}

.info-mono {
  font-family: monospace;
  font-size: 26rpx;
}

/* 兼容旧版Info Grid */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap-x: 48rpx;
  gap-y: 24rpx;
  font-size: 28rpx;
}

/* Test List */
.test-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.test-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #F0F0F0;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.test-item:active {
  background: #F7F7F7;
  border-color: #2563EB;
}

.test-icon {
  width: 80rpx;
  height: 80rpx;
  background: #F0F9FF;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.file-icon {
  width: 40rpx;
  height: 40rpx;
}

.test-info {
  flex: 1;
}

.test-name {
  font-size: 28rpx;
  color: #000000;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.test-meta {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.result-normal {
  color: #059669;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 64rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.empty-hint {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

/* Bottom Actions */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.bottom-actions button {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  transition: all 0.2s ease;
}

.bottom-actions .btn-outline {
  background: #FFFFFF;
  color: #888888;
  border: 1rpx solid #E5E5E5;
}

.bottom-actions .btn-outline:active {
  background: #F7F7F7;
  opacity: 0.8;
}

.bottom-actions .btn-primary {
  background: #2563EB;
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.bottom-actions .btn-primary:active {
  opacity: 0.8;
}

.bottom-actions button::after {
  border: none;
}
