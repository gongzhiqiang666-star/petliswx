@import "../../styles/petlis-3-overrides.wxss";

page {
  background: #F5F7F6;
}

.page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #F5F7F6;
  color: #263832;
}

.loading-state,
.error-state {
  display: flex;
  min-height: 70vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
}

.loading-text,
.error-text {
  margin-top: 24rpx;
  color: #85968F;
  font-size: 26rpx;
  font-weight: 300;
  line-height: 1.6;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
}

.error-state .error-text { color: #C96F45; }

.error-icon .icon {
  width: 100%;
  height: 100%;
  opacity: .55;
}

.btn-retry {
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;
  border-radius: 24rpx;
  background: #0D6E6E;
  color: #FFFFFF;
  font-size: 27rpx;
  line-height: 88rpx;
}

.btn-retry::after {
  border: 0;
}

.content {
  height: 100%;
  box-sizing: border-box;
  padding: 24rpx 0 calc(184rpx + env(safe-area-inset-bottom));
}

.pet-summary {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 0 32rpx 24rpx;
  padding: 36rpx;
  border: 1rpx solid #E7EEEA;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(11, 61, 58, .04);
}

.pet-avatar {
  display: flex;
  width: 128rpx;
  height: 128rpx;
  overflow: hidden;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E3EAE7;
  border-radius: 32rpx;
  background: #E6F0EC;
}

.pet-avatar image {
  width: 100%;
  height: 100%;
}

.pet-summary-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.pet-summary-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pet-summary-name {
  min-width: 0;
  overflow-wrap: anywhere;
  color: #0B3D3A;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: .5rpx;
}

.pet-gender {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: #E6F0EC;
  color: #0D6E6E;
  font-size: 21rpx;
  line-height: 1.5;
}

.pet-summary-breed {
  margin-top: 12rpx;
  overflow-wrap: anywhere;
  color: #667872;
  font-size: 26rpx;
  font-weight: 300;
  line-height: 1.55;
}

.pet-summary-meta {
  margin-top: 8rpx;
  overflow-wrap: anywhere;
  color: #98A8A3;
  font-size: 23rpx;
  font-weight: 300;
  line-height: 1.55;
}

.card {
  margin: 0 32rpx 24rpx;
  padding: 36rpx;
  border: 1rpx solid #E3EAE7;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(11, 61, 58, .05);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.header-line {
  width: 6rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 6rpx;
  background: #0D6E6E;
}

.card-title {
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: .5rpx;
}

.info-section {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #EBF0ED;
}

.info-section:last-child {
  border-bottom: 0;
}

.info-row {
  display: flex;
  gap: 28rpx;
}

.info-item {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 10rpx;
}

.info-item.half,
.info-item.full {
  min-width: 0;
  flex: 1;
}

.info-label {
  color: #98A8A3;
  font-size: 23rpx;
  font-weight: 300;
  line-height: 1.5;
}

.info-value {
  overflow-wrap: anywhere;
  color: #33443F;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1.55;
}

.info-mono {
  font-family: monospace;
  font-size: 25rpx;
}

.test-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.test-item {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid #E7EEEA;
  border-radius: 28rpx;
  background: #F5F7F6;
}

.test-item:active {
  border-color: #C7DAD3;
  background: #EDF3F0;
}

.test-icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #E6F0EC;
}

.file-icon {
  width: 38rpx;
  height: 38rpx;
}

.test-info {
  min-width: 0;
  flex: 1;
}

.test-name {
  overflow-wrap: anywhere;
  color: #263832;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.5;
}

.test-meta,
.test-status {
  margin-top: 8rpx;
  color: #98A8A3;
  font-size: 22rpx;
  font-weight: 300;
  line-height: 1.5;
}

.test-status {
  display: flex;
  gap: 6rpx;
}

.status-value {
  color: #0D6E6E;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: .45;
}

.empty-state {
  padding: 56rpx 0 32rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
}

.empty-icon .icon {
  width: 100%;
  height: 100%;
  opacity: .4;
}

.empty-text {
  margin-bottom: 10rpx;
  color: #667872;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1.5;
}

.empty-hint {
  color: #98A8A3;
  font-size: 23rpx;
  font-weight: 300;
  line-height: 1.6;
}

.bottom-actions {
  min-height: 136rpx;
  box-sizing: border-box;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E3EAE7;
  background: #FFFFFF;
  box-shadow: 0 -8rpx 24rpx rgba(11, 61, 58, .05);
}

.bottom-actions button {
  display: flex;
  min-width: 0;
  min-height: 88rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.bottom-actions .btn-outline {
  border: 1rpx solid #D7E4DF;
  background: #FFFFFF;
  color: #0D6E6E;
}

.bottom-actions .btn-outline:active {
  background: #E6F0EC;
}

.bottom-actions .btn-primary {
  background: #0D6E6E;
  box-shadow: 0 8rpx 20rpx rgba(13, 110, 110, .12);
  color: #FFFFFF;
}

.bottom-actions .btn-primary:active {
  background: #0B3D3A;
}

.bottom-actions button::after {
  border: 0;
}
