<view class="page"><view wx:if="{{forbidden}}" class="petlis-empty"><view class="petlis-empty-text">仅医院管理员可查看欠款</view></view><block wx:else><view wx:if="{{error}}" class="petlis-empty error"><view class="petlis-empty-text">{{error}}</view><button class="petlis-btn petlis-btn-outline" bindtap="load">重试</button></view><view wx:for="{{items}}" wx:key="id" class="card petlis-list-card" data-id="{{item.id}}" bindtap="openDetail"><view class="line"><text>{{item.billNo || item.bill_no}}</text><text>{{item.status}}</text></view><view class="amount">未结 ¥{{item.outstandingAmount || item.outstanding_amount}}</view><view class="meta">到期日 {{item.dueDate || item.due_date}} · 逾期 {{item.overdueDays || 0}} 天</view></view><view wx:if="{{!error && !items.length}}" class="petlis-empty"><image src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">暂无欠款</view></view></block></view>
