@import "../../styles/petlis-3-overrides.wxss";

page {
  background: var(--petlis-bg);
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

.content {
  display: block;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 224rpx;
  padding-bottom: calc(224rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(224rpx + env(safe-area-inset-bottom));
}

.flow-header {
  padding: 8rpx 8rpx 32rpx;
}

.flow-heading {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.flow-heading-copy {
  flex: 1;
  min-width: 0;
}

.flow-title {
  color: var(--petlis-text);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
}

.flow-hint {
  margin-top: 8rpx;
  color: var(--petlis-text-3);
  font-size: 26rpx;
  line-height: 1.6;
}

.draft-button {
  flex-shrink: 0;
  width: 176rpx;
  min-width: 176rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 16rpx;
  background: var(--petlis-tint);
  color: var(--petlis-primary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.draft-button::after {
  border: 0;
}

.draft-button[disabled] {
  background: var(--petlis-bg-soft);
  color: var(--petlis-text-4);
}

.flow-steps {
  display: flex;
  align-items: flex-start;
  margin-top: 32rpx;
}

.flow-step {
  display: flex;
  flex: 0 0 128rpx;
  flex-direction: column;
  align-items: center;
  color: var(--petlis-primary);
}

.flow-step-dot {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--petlis-tint);
  color: var(--petlis-primary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}

.flow-step.active .flow-step-dot {
  background: var(--petlis-primary);
  color: #FFFFFF;
  font-weight: 600;
}

.flow-step-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.flow-step.active .flow-step-label {
  color: var(--petlis-primary);
  font-weight: 600;
}

.flow-connector {
  flex: 1;
  height: 2rpx;
  min-width: 24rpx;
  margin-top: 23rpx;
  background: var(--petlis-tint);
}

.card {
  margin: 0 0 24rpx;
  border: 0;
  box-shadow: none;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.header-line {
  flex-shrink: 0;
  width: 6rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 3rpx;
  background: var(--petlis-primary);
}

.card-title {
  color: var(--petlis-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.patient-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid var(--petlis-bg-soft);
}

.patient-identity {
  flex: 1;
  min-width: 0;
}

.patient-name {
  overflow-wrap: anywhere;
  color: var(--petlis-text);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.patient-name-en {
  margin-top: 6rpx;
  overflow-wrap: anywhere;
  color: var(--petlis-text-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.patient-tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: var(--petlis-tint);
  color: var(--petlis-primary);
  font-size: 22rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 12rpx;
}

.info-item {
  display: flex;
  width: 50%;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 16rpx 20rpx 16rpx 0;
}

.info-item.info-full {
  width: 100%;
  padding-right: 0;
}

.info-label {
  color: var(--petlis-text-3);
  font-size: 24rpx;
  line-height: 1.4;
}

.info-value {
  overflow-wrap: anywhere;
  color: var(--petlis-text);
  font-size: 28rpx;
  line-height: 1.5;
}

.info-row-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-row,
.laboratory-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.row-label {
  flex: 0 0 140rpx;
  color: var(--petlis-text-3);
}

.row-value {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  color: var(--petlis-text);
  text-align: right;
}

.info-value.empty,
.row-value.empty {
  color: var(--petlis-text-4);
  font-style: normal;
}

.laboratory-row {
  margin-bottom: 8rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--petlis-bg-soft);
}

.laboratory-value {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  color: var(--petlis-text);
  font-weight: 500;
  text-align: right;
}

.test-items {
  display: flex;
  flex-direction: column;
}

.test-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--petlis-bg-soft);
}

.test-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  color: var(--petlis-text);
  font-size: 28rpx;
  line-height: 1.5;
}

.test-price {
  flex-shrink: 0;
  color: var(--petlis-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
}

.coupon-picker {
  display: block;
  margin-top: 20rpx;
}

.coupon-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--petlis-bg-soft);
}

.coupon-label {
  flex-shrink: 0;
  color: var(--petlis-text-2);
  font-size: 26rpx;
}

.coupon-value-wrap {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.coupon-value {
  min-width: 0;
  overflow: hidden;
  color: var(--petlis-text);
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-arrow {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  opacity: 0.7;
}

.quote-detail {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 24rpx 0 0;
}

.quote-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  color: var(--petlis-text-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.discount-row text:last-child {
  color: var(--petlis-accent);
}

.quote-status {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--petlis-tint);
  color: var(--petlis-primary);
  font-size: 24rpx;
  line-height: 1.5;
}

.quote-error {
  overflow-wrap: anywhere;
  background: var(--petlis-accent-bg);
  color: var(--petlis-accent);
}

.total-price {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--petlis-border);
}

.total-label {
  color: var(--petlis-text-2);
  font-size: 28rpx;
}

.total-amount {
  color: var(--petlis-primary);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.subscription-card {
  margin: 0 0 24rpx;
  padding: 26rpx 32rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: var(--petlis-tint);
}

.subscription-title {
  color: var(--petlis-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.subscription-option {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 12rpx;
  color: var(--petlis-text-2);
  font-size: 26rpx;
  line-height: 1.5;
}

.subscription-option checkbox {
  flex-shrink: 0;
  transform: scale(0.85);
  transform-origin: left center;
}

.subscription-option text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}

.subscription-fallback {
  margin-top: 12rpx;
  color: var(--petlis-text-2);
  font-size: 26rpx;
  line-height: 1.6;
}

.remark-text {
  overflow-wrap: anywhere;
  color: var(--petlis-text-2);
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.bottom-actions {
  display: block;
  padding: 16rpx 24rpx 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--petlis-border);
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.submit-note {
  margin-bottom: 12rpx;
  color: var(--petlis-text-3);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-buttons button {
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  white-space: nowrap;
}

.action-buttons button::after {
  border: 0;
}

.action-buttons .btn-outline {
  flex: 0 0 26%;
  width: 26%;
  border: 1rpx solid var(--petlis-border);
  background: #FFFFFF;
  color: var(--petlis-text-2);
}

.action-buttons .btn-primary {
  flex: 1;
  width: auto;
  min-width: 0;
  background: var(--petlis-primary);
  color: #FFFFFF;
}

.action-buttons .btn-primary:active {
  background: var(--petlis-primary-dark);
}

.action-buttons button[disabled] {
  background: var(--petlis-bg-soft);
  color: var(--petlis-text-4);
}

page {
  --petlis-bg: #F5F7F6;
  --petlis-bg-soft: #F8FAF9;
  --petlis-text: #263832;
  --petlis-text-2: #667872;
  --petlis-text-3: #85968F;
  --petlis-text-4: #A3B2AC;
  --petlis-border: #E3EAE7;
  --petlis-tint: #F2F7F5;
  --petlis-accent: #C96F45;
  --petlis-accent-bg: #F9F0E9;
  background: #F5F7F6;
}

.content {
  padding: 24rpx 24rpx 240rpx;
  padding-bottom: calc(240rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

.flow-header {
  padding: 0 8rpx 24rpx;
}

.flow-title {
  color: #0B3D3A;
  font-size: 42rpx;
  letter-spacing: 1rpx;
}

.flow-hint {
  margin-top: 12rpx;
  color: #85968F;
  font-size: 24rpx;
  font-weight: 300;
  letter-spacing: 0.5rpx;
}

.action-buttons .draft-button {
  min-width: 0;
  border: 1rpx solid #DCE6E2;
  border-radius: 44rpx;
  background: #FFFFFF;
  color: #0D6E6E;
  font-size: 24rpx;
}

.flow-steps {
  margin-top: 0;
}

.flow-step {
  color: #98A8A3;
}

.flow-step-dot {
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid #DCE6E2;
  background: #FFFFFF;
  color: #98A8A3;
  font-size: 21rpx;
  font-weight: 400;
}

.flow-step.active .flow-step-dot {
  border-color: #0B3D3A;
  background: #0B3D3A;
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 0 0 6rpx #E6F0EC;
}

.flow-step-label {
  margin-top: 16rpx;
  color: #98A8A3;
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

.flow-step.active .flow-step-label {
  color: #0B3D3A;
  font-weight: 500;
}

.flow-connector {
  height: 1rpx;
  margin-top: 21rpx;
  background: #DCE6E2;
}

.card {
  margin-bottom: 28rpx;
  border: 1rpx solid #E7EEEA;
  border-radius: 34rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(11, 61, 58, 0.05);
}

.card-header {
  margin-bottom: 32rpx;
}

.header-line {
  width: 4rpx;
  height: 30rpx;
  margin-right: 16rpx;
  background: #0B3D3A;
}

.card-title,
.patient-name {
  color: #263832;
  font-weight: 500;
  letter-spacing: 0.6rpx;
}

.card-title {
  font-size: 30rpx;
}

.patient-hero {
  border-bottom-color: #EBF0ED;
}

.patient-tag {
  border: 1rpx solid #DCE6E2;
  background: #F2F7F5;
  color: #0D6E6E;
  font-size: 20rpx;
  font-weight: 400;
}

.patient-name-en,
.info-label,
.row-label {
  color: #98A8A3;
  font-weight: 300;
}

.info-value,
.row-value,
.laboratory-value,
.test-name {
  color: #42534D;
  font-weight: 300;
}

.info-row,
.laboratory-row {
  line-height: 1.65;
}

.laboratory-row,
.test-item {
  border-bottom-color: #EBF0ED;
}

.test-price {
  color: #0B3D3A;
  font-weight: 400;
}

.coupon-row {
  border: 1rpx solid #E3EAE7;
  border-radius: 24rpx;
  background: #F8FAF9;
}

.coupon-label,
.coupon-value,
.quote-row {
  color: #7E908A;
  font-weight: 300;
}

.discount-row text:last-child {
  color: #C96F45;
}

.quote-status {
  border: 1rpx solid #DCE6E2;
  border-radius: 20rpx;
  background: #F2F7F5;
}

.quote-error {
  border-color: #ECD8CA;
  background: #F9F0E9;
  color: #C96F45;
}

.total-price {
  border-top-color: #E3EAE7;
}

.total-amount {
  color: #0B3D3A;
  font-size: 44rpx;
  font-weight: 300;
  letter-spacing: 0.5rpx;
}

.subscription-card {
  border: 1rpx solid #E7EEEA;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(11, 61, 58, 0.04);
}

.subscription-title {
  color: #263832;
  font-weight: 500;
}

.subscription-option,
.subscription-fallback,
.remark-text {
  color: #7E908A;
  font-weight: 300;
}

.bottom-actions {
  border-top-color: #E3EAE7;
  box-shadow: 0 -12rpx 32rpx rgba(11, 61, 58, 0.05);
}

.submit-note {
  color: #98A8A3;
  font-weight: 300;
  letter-spacing: 0.4rpx;
}

.action-buttons button {
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 500;
}

.action-buttons .btn-outline {
  border-color: #DCE6E2;
  color: #0D6E6E;
}

.action-buttons .btn-primary {
  background: #0B3D3A;
  box-shadow: 0 10rpx 24rpx rgba(11, 61, 58, 0.12);
}

.action-buttons .btn-primary:active {
  background: #0D6E6E;
}
