/* pages/icon-export/icon-export.wxss */

/* Header */
.header {
  background: #fff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #e5e7eb;
}

.back-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.header-title {
  font-size: 36rpx;
  color: #111827;
  font-weight: 600;
}

.placeholder {
  width: 48rpx;
}

/* Info Card */
.info-card {
  margin: 32rpx 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.info-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-icon {
  width: 40rpx;
  height: 40rpx;
}

.info-content {
  flex: 1;
}

.info-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.info-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* Format Section */
.format-section {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
}

.format-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.format-label {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
}

.format-options {
  display: flex;
  gap: 16rpx;
}

.format-option {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #374151;
  background: #fff;
}

.format-option.active {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #fff;
  border-color: transparent;
}

/* Select All Button */
.select-all-btn {
  margin: 0 24rpx 24rpx;
  height: 72rpx;
  background: #fff;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #374151;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
}

/* Icons Grid */
.icons-section {
  padding-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
}

.icons-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.icon-card {
  background: #fff;
  border-radius: 16rpx;
  border: 4rpx solid #E2E8F0;
  padding: 32rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s;
}

.icon-card.selected {
  border-color: #2563EB;
  background: #eef2ff;
}

.icon-preview {
  width: 96rpx;
  height: 96rpx;
  background: #f3f4f6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  transition: all 0.3s;
}

.icon-preview.selected {
  background: #DBEAFE;
}

.tab-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.icon-name {
  font-size: 28rpx;
  color: #111827;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.icon-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.check-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 32rpx;
  height: 32rpx;
  opacity: 0;
  transition: opacity 0.3s;
}

.check-badge.show {
  opacity: 1;
}

/* Preview Modal */
.preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.preview-content {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-close {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 48rpx;
  height: 48rpx;
}

.preview-icon-wrapper {
  width: 162rpx;
  height: 162rpx;
  background: #f3f4f6;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.preview-icon-img {
  width: 81rpx;
  height: 81rpx;
}

.preview-title {
  font-size: 36rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.preview-info {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.6;
}

/* Bottom Actions */

.stats-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16rpx;
}

.stats-text {
  font-size: 28rpx;
  color: #374151;
}

.stats-count {
  font-size: 28rpx;
  color: #2563EB;
  font-weight: 600;
}





.btn-icon {
  width: 32rpx;
  height: 32rpx;
}

.btn-primary[disabled] {
  opacity: 0.5;
}
