.history-page{padding:24rpx 24rpx 64rpx;background:#f6f8f7;min-height:100vh;box-sizing:border-box}.history-filters,.history-order,.history-error{padding:28rpx;margin-bottom:24rpx}.history-title{font-size:32rpx;font-weight:600;color:#183d3b;overflow-wrap:anywhere}.history-hint,.history-summary{font-size:24rpx;line-height:1.6;color:#687b79;margin:12rpx 0 20rpx}.history-filters .petlis-input{margin-top:16rpx;padding:20rpx;box-sizing:border-box;min-height:80rpx}.history-dates{display:flex;align-items:center;gap:12rpx}.history-dates picker{flex:1;min-width:0}.history-dates .petlis-input{font-size:24rpx}.history-actions{display:flex;gap:20rpx;margin-top:24rpx}.history-actions button{flex:1}.history-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx;margin-bottom:16rpx}.history-status{font-size:24rpx;color:#0d6e6e;white-space:nowrap}.history-line{font-size:26rpx;color:#425c59;line-height:1.8;overflow-wrap:anywhere}.history-rejection{background:#fff5ed;color:#8f4e25;padding:18rpx;margin-top:18rpx;font-size:26rpx;line-height:1.6;overflow-wrap:anywhere;border-radius:12rpx}.history-test{display:flex;justify-content:space-between;gap:20rpx;border-top:1rpx solid #e6eeeb;padding-top:20rpx;margin-top:20rpx;font-size:26rpx;line-height:1.6}.history-test>text:first-child{flex:1;overflow-wrap:anywhere}.history-report{color:#0d6e6e;white-space:nowrap;font-size:24rpx}.history-error{color:#9c4935;font-size:26rpx;line-height:1.6}.history-error button{margin-top:18rpx}.history-more{margin-top:24rpx}

.history-cancel{margin-top:24rpx;color:#8f4e25;border-color:#e4cdbb}
.history-test{flex-wrap:wrap;align-items:flex-start}.history-test>text:first-child{min-width:180rpx}.history-test button{flex:0 0 100%;box-sizing:border-box;min-height:88rpx;margin:12rpx 0 0;font-size:28rpx}
