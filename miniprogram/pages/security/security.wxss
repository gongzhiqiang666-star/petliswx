@import "../../styles/native-theme.wxss";
page{background:#F5F7F6;color:#263d37}.page{padding:24rpx 32rpx}.title{font-size:42rpx;font-weight:600;margin-bottom:16rpx}.hint{color:#66766f;font-size:26rpx;line-height:1.6;margin:16rpx 0 32rpx}.card{background:white;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}input{padding:24rpx 0;border-bottom:1rpx solid #e8ece8}button{margin-top:24rpx;font-size:30rpx}button[type=primary]{background:#26745e}.card.petlis-list-card{border-radius:20rpx}.error{color:#C96F45;margin:24rpx 0}button.petlis-btn-primary{background:var(--petlis-primary);color:#fff}button.petlis-btn-outline{background:#fff;color:var(--petlis-primary);border-color:var(--petlis-primary)}.petlis-input{margin-top:16rpx}.row{display:flex;gap:16rpx;align-items:center;margin-top:20rpx}.tabs{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:24rpx}.tabs button{font-size:26rpx;margin:0}.meta{font-size:26rpx;color:#66766f;margin:10rpx 0}.empty{text-align:center;padding:60rpx 0;color:#66766f}textarea{background:#f8faf8;width:100%;box-sizing:border-box;padding:16rpx;margin-top:16rpx;border-radius:12rpx}.links{margin-top:40rpx;text-align:center}.balance{font-size:48rpx;font-weight:600;margin:16rpx 0}.line{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #edf0ec}.badge{color:#26745e;font-size:24rpx}.nav{padding:26rpx 0;border-bottom:1rpx solid #e8ece8}.filters{display:flex;gap:16rpx}.filters button{font-size:26rpx;margin:0}.amount{font-size:32rpx;font-weight:600}.page{padding-bottom:calc(156rpx + env(safe-area-inset-bottom))}.bottom-actions{position:fixed;left:0;right:0;bottom:0;z-index:100;display:flex;gap:16rpx;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #E7EEEA;background:#FFFFFF;box-shadow:0 -2rpx 8rpx rgba(11,61,58,.04)}.bottom-actions .petlis-btn{flex:1;min-width:0;margin:0}.form-item{padding:20rpx 0;border-bottom:1rpx solid #F0F0F0}.form-item:last-child{border-bottom:0}.form-label{display:block;margin-bottom:12rpx;color:#1A1A1A;font-size:28rpx;font-weight:500;line-height:1.4}.form-item .petlis-input{margin-top:0}.form-item .row .petlis-input{min-width:0;flex:1}.error,.error .petlis-empty-text{color:#C96F45;font-size:22rpx}