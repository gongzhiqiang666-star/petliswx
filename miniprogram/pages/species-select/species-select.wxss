/* pages/species-select/species-select.wxss */

/* 搜索栏 */
.search-bar {
  margin: 16rpx 24rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 48rpx;
  border: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
}

/* 物种列表 */
.species-list {
  padding-bottom: 32rpx;
  height: calc(100vh - 200rpx);
}

.species-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.species-item:active {
  background-color: #f3f4f6;
  transform: scale(0.98);
}

.species-info {
  flex: 1;
  min-width: 0; /* 允许文本截断 */
}

.species-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2937;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.species-name-en {
  font-size: 26rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.species-check {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.check-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 加载更多提示 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.load-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 32rpx;
}

.btn-clear {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}

/* 列表容器 */
.list-container {
  position: relative;
  height: calc(100vh - 200rpx);
}

/* 分组标题 */
.group-header {
  padding: 24rpx 32rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6366f1;
  background: #f9fafb;
  position: sticky;
  top: 0;
  z-index: 10;
}

/* 字母索引栏 */
.index-bar {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 16rpx 8rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.index-item {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #6b7280;
  border-radius: 50%;
  transition: all 0.2s;
}

.index-item.active {
  background: #2563EB;
  color: #fff;
  font-weight: 600;
  transform: scale(1.2);
}
