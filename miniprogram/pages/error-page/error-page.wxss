/* pages/error-page/error-page.wxss */

/* 页面容器 */
.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx;
}

/* 错误容器 */
.error-container {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 64rpx 48rpx;
  box-shadow: 0 32rpx 96rpx rgba(37, 99, 235, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 错误图标 */
.error-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.15);
}

.error-icon {
  font-size: 96rpx;
}

/* 错误标题 */
.error-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 24rpx;
  text-align: center;
}

/* 错误描述 */
.error-message {
  font-size: 28rpx;
  color: #64748B;
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

/* 错误建议 */
.error-suggestion {
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  width: 100%;
  border: 1rpx solid #E2E8F0;
}

.suggestion-text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.8;
  white-space: pre-line;
}

/* 错误详情 */
.error-details {
  width: 100%;
  background: #FEF2F2;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #FEE2E2;
}

.detail-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  color: #64748B;
  min-width: 140rpx;
}

.detail-value {
  color: #1E293B;
  flex: 1;
  word-break: break-all;
}

/* 切换详情按钮 */
.toggle-details {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
  transition: all 0.3s;
}

.toggle-text {
  font-size: 26rpx;
  color: #6366F1;
}

.toggle-arrow {
  width: 24rpx;
  height: 24rpx;
  transition: transform 0.3s;
}

.toggle-arrow.rotate {
  transform: rotate(180deg);
}

/* 操作按钮 */
.action-buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.btn-primary,
.btn-secondary,
.btn-contact {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.25);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: #FFFFFF;
  color: #6366F1;
  border: 2rpx solid #6366F1;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: #EFF6FF;
}

.btn-contact {
  background: #F8FAFC;
  color: #64748B;
  border: none;
}

.btn-contact::after {
  border: none;
}

.btn-contact:active {
  background: #F1F5F9;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: #94A3B8;
}
