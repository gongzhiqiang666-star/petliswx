<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button class="petlis-btn petlis-btn-outline" bindtap="load">重试</button></view><view wx:if="{{article}}"><view class="title">{{article.title}}</view><view class="meta">{{article.category}} · {{article.published_at}}</view><view wx:if="{{article.type==='live'}}" class="card petlis-list-card"><view>{{countdown}}</view><button class="petlis-btn petlis-btn-outline" bindtap="live">复制直播链接</button></view><view class="card petlis-list-card"><rich-text nodes="{{article.content}}"/></view><view class="bottom-actions"><button class="petlis-btn petlis-btn-outline" data-key="liked" bindtap="action" disabled="{{busy}}">{{article.liked?'已点赞':'点赞'}}</button><button class="petlis-btn petlis-btn-primary" data-key="bookmarked" bindtap="action" disabled="{{busy}}">{{article.bookmarked?'已收藏':'收藏'}}</button></view></view></view>