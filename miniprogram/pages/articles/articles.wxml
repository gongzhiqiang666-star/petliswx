<view class="page">
  <view class="row"><picker class="category-picker petlis-filters" range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="nav petlis-filter-item active"><text class="nav-label">分类：{{categories[categoryIndex]}}</text><image class="nav-chevron" src="/assets/icons/brand-chevron-down.png" mode="aspectFit" /></view></picker><button class="petlis-btn petlis-btn-outline" bindtap="bookmarks" disabled="{{busy}}">{{bookmarked?'我的收藏':'全部资讯'}}</button></view>
  <view wx:if="{{error}}" class="error petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">{{error}}</view><button class="petlis-btn petlis-btn-outline" bindtap="retry">重试</button></view>
  <view wx:for="{{items}}" wx:key="id" class="card petlis-list-card" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" style="height:280rpx;width:100%;border-radius:16rpx"/><view>{{item.title}}</view><view class="hint">{{item.summary}}</view><view class="badge">{{item.type==='live'?'直播':item.type==='activity'?'活动':item.category}}</view><view class="meta">{{item.publishedAt}}</view></view>
  <view wx:if="{{!busy && !items.length && !error}}" class="empty petlis-empty"><image class="empty-icon" src="/assets/icons/brand-empty.png" mode="aspectFit" /><view class="petlis-empty-text">{{bookmarked?'暂无收藏':'暂无已发布资讯'}}</view></view>
  <button wx:if="{{more}}" class="petlis-btn petlis-btn-outline" bindtap="more" loading="{{busy}}">加载更多</button>
</view>